{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:model_provider_policy:v1",
  "title": "NAOS Model Provider Policy Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "policy_path",
    "policy_source",
    "policy_hash",
    "enabled",
    "runtime_enabled",
    "provider_calls_allowed",
    "credentials_allowed_in_repo",
    "profile_posture",
    "default_alias_policy",
    "roles",
    "referenced_roles",
    "agent_role_coverage",
    "duplicate_provider_detail_refs",
    "tool_model_bindings",
    "tool_binding_counts",
    "provider_kind_counts",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.model_provider_policy.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string", "enum": ["quickstart", "lite", "standard", "assured"] },
    "status": {
      "type": "string",
      "enum": ["declaration_only", "advisory", "warning", "review_required", "blocked", "not_configured"]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "policy_path": { "type": "string" },
    "policy_source": { "type": "string", "enum": ["project", "template", "explicit", "missing"] },
    "policy_hash": { "type": ["string", "null"] },
    "enabled": { "type": "boolean" },
    "runtime_enabled": { "type": "boolean" },
    "provider_calls_allowed": { "type": "boolean" },
    "credentials_allowed_in_repo": { "type": "boolean" },
    "profile_posture": { "type": "object" },
    "default_alias_policy": { "type": "object" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "enabled",
          "referenced",
          "provider_kind",
          "model_declared",
          "model_version_declared",
          "reasoning_effort_declared",
          "alias_allowed",
          "runtime_enabled",
          "advisory_only",
          "human_review_required"
        ],
        "properties": {
          "role": { "type": "string" },
          "enabled": { "type": "boolean" },
          "referenced": { "type": "boolean" },
          "provider_kind": { "type": ["string", "null"] },
          "provider": { "type": ["string", "null"] },
          "model_declared": { "type": "boolean" },
          "model_version_declared": { "type": "boolean" },
          "reasoning_effort": { "type": ["string", "null"] },
          "reasoning_effort_declared": { "type": "boolean" },
          "alias_allowed": { "type": "boolean" },
          "runtime_enabled": { "type": "boolean" },
          "advisory_only": { "type": "boolean" },
          "cost_tier": { "type": ["string", "null"] },
          "data_exposure_level": { "type": ["string", "null"] },
          "human_review_required": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "referenced_roles": { "type": "array", "items": { "type": "object" } },
    "agent_role_coverage": {
      "type": "object",
      "required": ["agent_files", "agent_role_refs", "agent_role_gaps", "gaps"],
      "properties": {
        "agent_files": { "type": "integer", "minimum": 0 },
        "agent_role_refs": { "type": "integer", "minimum": 0 },
        "agent_role_gaps": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "duplicate_provider_detail_refs": { "type": "array", "items": { "type": "object" } },
    "tool_model_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "tool",
          "tool_family",
          "tool_known",
          "enabled",
          "role",
          "role_declared",
          "provider_kind",
          "model_declared",
          "reasoning_effort_declared",
          "mutation_allowed",
          "human_review_required"
        ],
        "properties": {
          "source": { "type": "string" },
          "tool": { "type": "string" },
          "tool_family": { "type": "string" },
          "tool_known": { "type": "boolean" },
          "tool_enabled": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "role": { "type": "string" },
          "role_declared": { "type": "boolean" },
          "provider_kind": { "type": "string" },
          "provider": { "type": ["string", "null"] },
          "provider_declared": { "type": "boolean" },
          "model": { "type": ["string", "null"] },
          "model_declared": { "type": "boolean" },
          "model_version": { "type": ["string", "null"] },
          "model_version_declared": { "type": "boolean" },
          "reasoning_effort": { "type": ["string", "null"] },
          "reasoning_effort_declared": { "type": "boolean" },
          "model_alias": { "type": ["string", "null"] },
          "alias_allowed": { "type": "boolean" },
          "cost_tier": { "type": ["string", "null"] },
          "data_exposure_level": { "type": ["string", "null"] },
          "mutation_allowed": { "type": "boolean" },
          "human_review_required": { "type": "boolean" },
          "has_rationale": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "tool_binding_counts": {
      "type": "object",
      "required": [
        "tools_declared",
        "role_bindings_declared",
        "active_role_bindings",
        "unknown_tools",
        "mutation_allowed",
        "cross_tool_drift_roles"
      ],
      "properties": {
        "tools_declared": { "type": "integer", "minimum": 0 },
        "role_bindings_declared": { "type": "integer", "minimum": 0 },
        "active_role_bindings": { "type": "integer", "minimum": 0 },
        "unknown_tools": { "type": "integer", "minimum": 0 },
        "mutation_allowed": { "type": "integer", "minimum": 0 },
        "cross_tool_drift_roles": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "provider_kind_counts": { "type": "object" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "known_gaps": { "type": "array", "items": { "type": "string" } },
    "residual_risks": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "not_claimed": { "type": "array", "items": { "type": "string" } },
    "human_review_required": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": [
        "blocking",
        "required",
        "warnings",
        "advisory",
        "total_findings",
        "roles_declared",
        "roles_referenced",
        "agent_role_refs",
        "agent_role_gaps",
        "tool_role_bindings",
        "active_tool_role_bindings",
        "runtime_enabled",
        "provider_calls_allowed",
        "credentials_allowed_in_repo"
      ],
      "properties": {
        "blocking": { "type": "integer", "minimum": 0 },
        "required": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "advisory": { "type": "integer", "minimum": 0 },
        "total_findings": { "type": "integer", "minimum": 0 },
        "roles_declared": { "type": "integer", "minimum": 0 },
        "roles_referenced": { "type": "integer", "minimum": 0 },
        "agent_role_refs": { "type": "integer", "minimum": 0 },
        "agent_role_gaps": { "type": "integer", "minimum": 0 },
        "tool_role_bindings": { "type": "integer", "minimum": 0 },
        "active_tool_role_bindings": { "type": "integer", "minimum": 0 },
        "runtime_enabled": { "type": "boolean" },
        "provider_calls_allowed": { "type": "boolean" },
        "credentials_allowed_in_repo": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
