{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adopter declared AI metadata scope (not ownership or vendor validity)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "host_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "allOf": [
          {
            "pattern": "^\\.(?:github/(agents/.+\\.agent\\.md|skills/.+/SKILL\\.md|instructions/.+\\.instructions\\.md)|(?:agents|claude)/skills/[^/]+/SKILL\\.md)$"
          },
          {
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)|[\\\\:*?\\[\\]\\x00-\\x1f\\x7f-\\x9f]|//|[ .](/|$)|^\\s|\\s$"
            }
          }
        ]
      }
    }
  }
}
