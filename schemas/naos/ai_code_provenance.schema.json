{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:ai_code_provenance:v1",
  "title": "NAOS AI Code Provenance Review Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "command",
    "naos_root",
    "project_root",
    "manifest",
    "supporting_evidence",
    "ai_artifact_evidence",
    "missing_evidence",
    "unresolved_questions",
    "authority_boundary",
    "runtime_posture",
    "cost_posture",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "recommended_next_commands",
    "next_actions",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.ai_code_provenance.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string", "enum": ["quickstart", "lite", "standard", "assured"] },
    "status": {
      "type": "string",
      "enum": ["not_configured", "incomplete", "review_ready", "review_required"]
    },
    "command": { "const": "ai-code-provenance" },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "manifest": { "type": "object" },
    "supporting_evidence": { "type": "array", "items": { "type": "object" } },
    "ai_artifact_evidence": { "type": "object" },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } },
    "authority_boundary": { "type": "object" },
    "runtime_posture": { "type": "object" },
    "cost_posture": { "type": "object" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "known_gaps": { "type": "array" },
    "residual_risks": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "not_claimed": { "type": "array", "items": { "type": "string" } },
    "recommended_next_commands": { "type": "array", "items": { "type": "object" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
