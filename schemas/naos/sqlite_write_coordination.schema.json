{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:sqlite_write_coordination:v1",
  "title": "NAOS SQLite Write Coordination Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "target_db_path",
    "lock_path",
    "lock_acquired",
    "lock_wait_seconds",
    "lock_timeout_seconds",
    "stale_lock_detected",
    "stale_lock_action",
    "temp_db_path",
    "atomic_replace_used",
    "busy_timeout_ms",
    "wal_requested",
    "wal_effective",
    "wal_checkpointed",
    "sqlite_version",
    "session_id",
    "operator_id",
    "generated_by",
    "tables_verified",
    "target_db_hash",
    "cleanup_actions",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.sqlite_write_coordination.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "advisory",
        "lock_acquired",
        "lock_timeout",
        "stale_lock_detected",
        "replace_failed",
        "validation_failed",
        "not_configured",
        "blocked",
        "unknown"
      ]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "target_db_path": { "type": ["string", "null"] },
    "lock_path": { "type": ["string", "null"] },
    "lock_acquired": { "type": "boolean" },
    "lock_wait_seconds": { "type": "number" },
    "lock_timeout_seconds": { "type": "number" },
    "stale_lock_detected": { "type": "boolean" },
    "stale_lock_action": { "type": "string" },
    "temp_db_path": { "type": ["string", "null"] },
    "atomic_replace_used": { "type": "boolean" },
    "busy_timeout_ms": { "type": "integer" },
    "wal_requested": { "type": "boolean" },
    "wal_effective": { "type": "boolean" },
    "wal_checkpointed": { "type": "boolean" },
    "sqlite_version": { "type": "string" },
    "session_id": { "type": ["string", "null"] },
    "operator_id": { "type": ["string", "null"] },
    "generated_by": { "type": "object" },
    "tables_verified": { "type": "array", "items": { "type": "string" } },
    "target_db_hash": { "type": ["string", "null"] },
    "cleanup_actions": { "type": "array" },
    "findings": { "type": "array" },
    "known_gaps": { "type": "array" },
    "residual_risks": { "type": "array" },
    "limitations": { "type": "array" },
    "not_claimed": { "type": "array" },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
