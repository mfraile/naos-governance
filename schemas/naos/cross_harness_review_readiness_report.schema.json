{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:cross_harness_review_readiness_report:v1",
  "title": "NAOS Cross-Harness Review Readiness Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "config_path",
    "config_present",
    "config_valid",
    "runtime_execution_enabled",
    "harness_execution_allowed",
    "provider_api_allowed",
    "external_network_allowed",
    "declared_harness_count",
    "declared_harnesses",
    "dsse_readiness",
    "readiness_requirements",
    "requirements_missing",
    "requirements_deferred",
    "readiness_score",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.cross_harness_review_readiness_report.v1"},
    "generated_at": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"enum": ["ready", "advisory", "review_required", "missing_config", "invalid_config", "unsafe_runtime_enabled", "signing_enabled_in_core", "provider_api_enabled", "missing_requirements", "unknown"]},
    "naos_root": {"type": "string"},
    "config_path": {"type": "string"},
    "config_present": {"type": "boolean"},
    "config_valid": {"type": "boolean"},
    "runtime_execution_enabled": {"type": "boolean"},
    "harness_execution_allowed": {"type": "boolean"},
    "provider_api_allowed": {"type": "boolean"},
    "external_network_allowed": {"type": "boolean"},
    "declared_harness_count": {"type": "integer", "minimum": 0},
    "declared_harnesses": {"type": "array", "items": {"type": "object"}},
    "dsse_readiness": {"type": "object"},
    "readiness_requirements": {"type": "array", "items": {"type": "object"}},
    "requirements_missing": {"type": "array", "items": {"type": "object"}},
    "requirements_deferred": {"type": "array", "items": {"type": "object"}},
    "readiness_score": {"type": "integer", "minimum": 0},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  }
}
