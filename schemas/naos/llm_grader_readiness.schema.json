{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:llm_grader_readiness:v1",
  "title": "NAOS LLMGrader Readiness Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "rules_path",
    "rules_hash",
    "runtime_enabled",
    "provider_allowed",
    "external_api_allowed",
    "model_dependency_allowed",
    "api_keys_allowed",
    "cost_posture",
    "data_exposure_posture",
    "model_posture",
    "prompt_rubric_posture",
    "bias_variance_posture",
    "residual_risk_posture",
    "deterministic_baseline",
    "static_grader_primary",
    "advisory_boundary",
    "future_enablement_requirements",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.llm_grader_readiness.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string", "enum": ["quickstart", "lite", "standard", "assured"] },
    "status": {
      "type": "string",
      "enum": ["disabled", "readiness_only", "advisory", "review_required", "blocked", "not_configured", "unknown"]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "rules_path": { "type": "string" },
    "rules_hash": { "type": ["string", "null"] },
    "runtime_enabled": { "type": "boolean" },
    "provider_allowed": { "type": "boolean" },
    "external_api_allowed": { "type": "boolean" },
    "model_dependency_allowed": { "type": "boolean" },
    "api_keys_allowed": { "type": "boolean" },
    "cost_posture": {
      "type": "object",
      "required": [
        "cost_usd",
        "cost_incurred_by_default",
        "external_api_required",
        "provider_dependency_required",
        "model_dependency_required",
        "cost_budget_required_if_enabled_later",
        "human_approval_required_before_cost",
        "max_cost_usd",
        "max_runs_per_day"
      ],
      "properties": {
        "cost_usd": { "type": "number", "minimum": 0 },
        "cost_incurred_by_default": { "type": "boolean" },
        "external_api_required": { "type": "boolean" },
        "provider_dependency_required": { "type": "boolean" },
        "model_dependency_required": { "type": "boolean" },
        "cost_budget_required_if_enabled_later": { "type": "boolean" },
        "human_approval_required_before_cost": { "type": "boolean" },
        "max_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "max_runs_per_day": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "data_exposure_posture": { "type": "object" },
    "model_posture": { "type": "object" },
    "prompt_rubric_posture": { "type": "object" },
    "bias_variance_posture": { "type": "object" },
    "residual_risk_posture": { "type": "object" },
    "deterministic_baseline": { "type": "object" },
    "static_grader_primary": { "type": "boolean" },
    "advisory_boundary": { "type": "object" },
    "future_enablement_requirements": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "known_gaps": { "type": "array", "items": { "type": "string" } },
    "residual_risks": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "not_claimed": { "type": "array", "items": { "type": "string" } },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
