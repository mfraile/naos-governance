{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:agent-sponsor-registry:v1",
  "title": "NAOS Agent Sponsor Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "enabled",
    "decision_supported",
    "registry_owner_ref",
    "credential_policy",
    "records",
    "routing",
    "non_claims"
  ],
  "properties": {
    "schema": {"const": "naos.agent_sponsor_registry.v1"},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"const": "agent_sponsor_registry.v1"},
        "version": {"const": 1},
        "kind": {"const": "build_time_declared_posture"}
      }
    },
    "enabled": {"const": true},
    "decision_supported": {"type": "string", "minLength": 1},
    "registry_owner_ref": {"$ref": "#/$defs/sponsor_or_owner_ref"},
    "credential_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_secret_values_allowed",
        "credential_validation_performed",
        "accepted_postures"
      ],
      "properties": {
        "repository_secret_values_allowed": {"const": false},
        "credential_validation_performed": {"const": false},
        "accepted_postures": {
          "const": [
            "no_credentials_declared",
            "external_short_lived_declared",
            "external_exception_declared"
          ]
        }
      }
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "source_type", "target_gates"],
      "properties": {
        "consumer": {"const": "scripts/naos_control_plane_review.py"},
        "source_type": {"const": "agent_sponsor_registry_finding"},
        "target_gates": {"const": ["G2", "G6"]}
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sponsor_or_owner_ref": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^(role|team|group):[a-z0-9][a-z0-9._/-]*$"
    },
    "control_ref": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^(control|policy):[a-z0-9][a-z0-9._/-]*$"
    },
    "nullable_sponsor_or_owner_ref": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sponsor_or_owner_ref"}
      ]
    },
    "nullable_control_ref": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/control_ref"}
      ]
    },
    "credential_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "owner_ref",
        "control_ref",
        "repository_secret_values_present"
      ],
      "properties": {
        "mode": {
          "enum": [
            "no_credentials_declared",
            "external_short_lived_declared",
            "external_exception_declared"
          ]
        },
        "owner_ref": {"$ref": "#/$defs/nullable_sponsor_or_owner_ref"},
        "control_ref": {"$ref": "#/$defs/nullable_control_ref"},
        "repository_secret_values_present": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "no_credentials_declared"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "owner_ref": {"type": "null"},
              "control_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "external_short_lived_declared",
                  "external_exception_declared"
                ]
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "owner_ref": {"$ref": "#/$defs/sponsor_or_owner_ref"},
              "control_ref": {"$ref": "#/$defs/control_ref"}
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "reviewed_at", "expires_at"],
      "properties": {
        "owner_ref": {"$ref": "#/$defs/sponsor_or_owner_ref"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "sponsor_ref",
        "ownership_scope",
        "credential_posture",
        "review"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^CAP-A-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "sponsor_ref": {"$ref": "#/$defs/sponsor_or_owner_ref"},
        "ownership_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "purpose",
              "tool_scope",
              "data_handling",
              "cost",
              "human_review"
            ]
          }
        },
        "credential_posture": {"$ref": "#/$defs/credential_posture"},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
