{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:external_evidence_ingest:v2",
  "title": "NAOS External Evidence Ingest Report",
  "description": "Deterministic local SARIF ingest with per-result human-review records. Imported results remain unverified external evidence and are not approval, attestation, certification, risk decisions, or proof of compliance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "project_root",
    "naos_root",
    "deterministic",
    "cost_posture",
    "summary",
    "scans",
    "assessment",
    "result_records",
    "findings",
    "waivers",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required"
  ],
  "properties": {
    "schema": {"const": "naos.external_evidence_ingest.v2"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"type": "string", "enum": ["pass", "advisory", "warning", "required_missing", "blocked"]},
    "project_root": {"type": "string"},
    "naos_root": {"type": "string"},
    "deterministic": {"type": "boolean"},
    "cost_posture": {"type": "object"},
    "summary": {"type": "object", "additionalProperties": true},
    "scans": {"type": "object", "additionalProperties": true},
    "assessment": {"$ref": "#/$defs/assessment"},
    "result_records": {"type": "array", "items": {"$ref": "#/$defs/result_record"}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "waivers": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"}
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_execution_status", "result_posture", "coverage_status", "human_review_required"],
      "properties": {
        "source_execution_status": {
          "type": "string",
          "enum": ["not_configured", "source_missing", "parse_error", "not_assessed", "unknown", "reported_success", "reported_failure"]
        },
        "result_posture": {"type": "string", "enum": ["not_assessed", "unknown", "zero_results_reported", "results_reported"]},
        "coverage_status": {"const": "not_declared"},
        "human_review_required": {"type": "boolean"}
      }
    },
    "result_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_result_id",
        "origin",
        "source_sha256",
        "run_index",
        "result_index",
        "identity_basis",
        "identity_stability",
        "source_identity_sha256",
        "tool_name",
        "tool_version",
        "native_rule_id",
        "native_level",
        "native_level_status",
        "artifact_uri",
        "source_declared_taxonomy_refs",
        "control_link_status",
        "classification",
        "verification_status",
        "review_disposition",
        "human_review_required",
        "message_retention"
      ],
      "properties": {
        "external_result_id": {"type": "string", "pattern": "^sarif-[0-9a-f]{64}$"},
        "origin": {"const": "external_unverified"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_index": {"type": "integer", "minimum": 0},
        "result_index": {"type": "integer", "minimum": 0},
        "identity_basis": {"type": "string", "enum": ["guid", "partial_fingerprints", "position"]},
        "identity_stability": {"type": "string", "enum": ["source_declared", "exact_artifact_position"]},
        "source_identity_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "tool_name": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "native_rule_id": {"type": "string", "minLength": 1},
        "native_level": {"type": "string", "minLength": 1},
        "native_level_status": {"type": "string", "enum": ["recognized_native", "unmapped"]},
        "artifact_uri": {"type": ["string", "null"]},
        "source_declared_taxonomy_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "control_link_status": {"type": "string", "enum": ["missing", "source_declared_unverified"]},
        "classification": {"const": "unknown"},
        "verification_status": {"const": "unverified"},
        "review_disposition": {"const": "needs_review"},
        "human_review_required": {"const": true},
        "message_retention": {"const": "omitted"}
      }
    }
  }
}
