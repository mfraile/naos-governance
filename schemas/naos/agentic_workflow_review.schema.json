{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:agentic_workflow_review:v1",
  "title": "NAOS Agentic Workflow Review Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "workflow_config_path",
    "workflow_config_present",
    "workflow_config_valid",
    "sections",
    "context_hygiene",
    "pre_implementation_alignment",
    "vertical_slice_delivery",
    "tdd_feedback",
    "module_design",
    "human_ai_work_split",
    "kanban_dag",
    "push_pull_context",
    "related_artifacts",
    "missing_artifacts",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.agentic_workflow_review.v1"},
    "generated_at": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {
      "enum": ["ready", "advisory", "review_required", "not_configured", "missing_config", "invalid_config", "missing_artifacts", "blocked", "unknown"]
    },
    "naos_root": {"type": "string"},
    "workflow_config_path": {"type": "string"},
    "workflow_config_present": {"type": "boolean"},
    "workflow_config_valid": {"type": "boolean"},
    "sections": {"type": "array", "items": {"type": "object"}},
    "optional_sections": {"type": "array", "items": {"type": "object"}},
    "context_hygiene": {"type": "object"},
    "pre_implementation_alignment": {"type": "object"},
    "vertical_slice_delivery": {"type": "object"},
    "tdd_feedback": {"type": "object"},
    "module_design": {"type": "object"},
    "human_ai_work_split": {"type": "object"},
    "kanban_dag": {"type": "object"},
    "parallel_lane_opportunity": {"type": "object"},
    "push_pull_context": {"type": "object"},
    "related_artifacts": {"type": "array", "items": {"type": "object"}},
    "missing_artifacts": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  }
}
