{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:intake_report:v1",
  "title": "NAOS Guided Intake Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "generated_at", "profile", "status", "command", "mode", "naos_root", "project_root", "human_review_required", "not_claimed", "limitations", "findings", "summary"],
  "properties": {
    "schema": {"const": "naos.intake_report.v1"},
    "generated_at": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"enum": ["ready", "advisory", "review_required", "warning", "invalid_config", "blocked", "unknown"]},
    "command": {"const": "intake"},
    "mode": {"type": "string"},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "session_id": {"type": ["string", "null"]},
    "generated_by": {"type": "object"},
    "human_review_required": {"type": "boolean"},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array"},
    "residual_risks": {"type": "array"},
    "summary": {"type": "object"}
  }
}
