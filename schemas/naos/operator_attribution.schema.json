{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:operator_attribution:v1",
  "title": "NAOS Operator Attribution Report",
  "description": "Report describing local operator attribution signals for a NAOS run. It identifies who initiated a run where possible, but it is not authentication, authorization, task ownership, task locking, separation-of-duties evidence, non-repudiation, approval, or an audit log.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "session_id",
    "session_report_root",
    "generated_by",
    "operator_id",
    "operator_source",
    "operator_resolution_order",
    "operator_attribution_status",
    "operator_aware_reports",
    "operator_pending_reports",
    "git_user_email_detected",
    "git_user_name_detected",
    "env_operator_id_detected",
    "os_user_detected",
    "privacy_posture",
    "pii_warning",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"type": "string", "const": "naos.operator_attribution.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"type": "string", "enum": ["ready", "advisory", "review_required", "unknown_operator", "not_configured", "blocked", "unknown"]},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "session_id": {"type": ["string", "null"]},
    "session_report_root": {"type": ["string", "null"]},
    "generated_by": {"type": "object"},
    "operator_id": {"type": ["string", "null"]},
    "operator_source": {"type": "string", "enum": ["env", "git_email", "git_name", "os_user", "unknown"]},
    "operator_resolution_order": {"type": "array", "items": {"type": "string"}},
    "operator_attribution_status": {"type": "string", "enum": ["resolved", "unknown", "conflicting", "not_configured"]},
    "operator_aware_reports": {"type": "array", "items": {"type": "string"}},
    "operator_pending_reports": {"type": "array", "items": {"type": "string"}},
    "git_user_email_detected": {"type": "boolean"},
    "git_user_name_detected": {"type": "boolean"},
    "env_operator_id_detected": {"type": "boolean"},
    "os_user_detected": {"type": "boolean"},
    "operator_id_validation": {"type": "object"},
    "privacy_posture": {"type": "object"},
    "pii_warning": {"type": "string"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  }
}
