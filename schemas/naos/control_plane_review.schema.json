{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:control_plane_review:v1",
  "title": "NAOS Control-Plane Review Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "summary",
    "governance_surface_review",
    "research_routing",
    "routing_decisions",
    "findings",
    "known_gaps",
    "residual_risks",
    "waivers",
    "human_review_required",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "naos.control_plane_review.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string"},
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "routed",
        "review_required",
        "missing_routing",
        "blocked",
        "advisory",
        "warning",
        "required_missing",
        "not_configured",
        "disabled",
        "waived",
        "unknown"
      ]
    },
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "rules": {"type": "object"},
    "items": {"type": "object"},
    "summary": {"type": "object"},
    "governance_surface_review": {"$ref": "#/$defs/section"},
    "research_routing": {"$ref": "#/$defs/section"},
    "parallel_lane_handoff_reconciliation": {"$ref": "#/$defs/parallel_lane_handoff_reconciliation"},
    "external_sarif_result_reconciliation": {"$ref": "#/$defs/model_provider_policy_reconciliation"},
