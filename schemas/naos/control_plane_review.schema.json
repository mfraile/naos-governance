  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "summary", "items"],
      "properties": {
        "status": {"type": "string"},
        "summary": {"type": "object"},
        "items": {
          "type": "array",
          "items": {"$ref": "#/$defs/routing_decision"}
        }
      }
    },
    "routing_decision": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "source_type",
        "source_ref",
        "summary",
        "target_surfaces",
        "status",
        "human_review_required",
        "required_next_actions"
      ],
      "properties": {
        "id": {"type": "string"},
        "source_type": {"type": "string"},
        "source_ref": {"type": "string"},
        "summary": {"type": "string"},
        "source_artifact_family": {"type": "string"},
        "target_surfaces": {
          "type": "array",
          "items": {"type": "string"}
        },
        "status": {
          "type": "string",
          "enum": [
            "routed",
            "review_required",
            "missing_routing",
            "blocked",
            "advisory",
            "not_configured",
            "disabled",
            "waived",
            "unknown"
          ]
        },
        "human_review_required": {"type": "boolean"},
        "known_gap_ref": {"type": ["string", "null"]},
        "residual_risk_ref": {"type": ["string", "null"]},
        "waiver_ref": {"type": ["string", "null"]},
        "required_next_actions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
