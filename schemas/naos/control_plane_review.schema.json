        "status": {
          "type": "string",
          "enum": [
            "pass",
            "routed",
            "review_required",
            "missing_routing",
            "blocked",
            "advisory",
            "warning",
            "required_missing",
            "not_configured",
            "disabled",
            "waived",
            "unknown",
            "not_applicable"
          ]
        },
        "summary": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "handoff_reports_found",
            "declared_lane_reports",
            "routes_generated",
            "hitl_required",
            "reason_code_counts"
          ],
          "properties": {
            "handoff_reports_found": {"type": "integer", "minimum": 0},
            "declared_lane_reports": {"type": "integer", "minimum": 0},
            "routes_generated": {"type": "integer", "minimum": 0},
            "hitl_required": {"type": "integer", "minimum": 0},
            "reason_code_counts": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            }
          }
        },
        "source_reports": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "optional_report_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "routes": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "not_claimed": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
