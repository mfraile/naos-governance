    "aivss_arithmetic_verification_reconciliation": {"$ref": "#/$defs/model_provider_policy_reconciliation"},
    "model_provider_policy_reconciliation": {"$ref": "#/$defs/model_provider_policy_reconciliation"},
    "model_telemetry_evidence_reconciliation": {"$ref": "#/$defs/model_telemetry_evidence_reconciliation"},
    "failure_mode_posture_reconciliation": {"$ref": "#/$defs/failure_mode_posture_reconciliation"},
    "failure_mode_observations_reconciliation": {"$ref": "#/$defs/failure_mode_observations_reconciliation"},
    "opencode_config_hygiene_reconciliation": {"$ref": "#/$defs/opencode_config_hygiene_reconciliation"},
    "design_traceability_reconciliation": {"$ref": "#/$defs/design_traceability_reconciliation"},
    "ui_experience_quality_reconciliation": {"$ref": "#/$defs/ui_experience_quality_reconciliation"},
    "routing_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/routing_decision"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "known_gaps": {
      "type": "array",
      "items": {"type": "object"}
    },
    "residual_risks": {
      "type": "array",
      "items": {"type": "object"}
    },
    "waivers": {
      "type": "array",
      "items": {"type": "object"}
    },
    "human_review_required": {"type": "boolean"},
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
