        "source_report": {"type": "object", "additionalProperties": true},
        "source_report_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "routes": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
