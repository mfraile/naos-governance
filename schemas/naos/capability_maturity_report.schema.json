{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:capability_maturity_report:v1",
  "title": "NAOS Capability Maturity Report",
  "description": "Schema for maturity readiness and invalid-input reports emitted by scripts/naos_capability_maturity.py. A readiness report does not promote, certify, approve, or prove capability maturity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "findings"],
  "allOf": [
    {
      "if": {"properties": {"schema": {"const": "naos.capability_maturity_input_error.v1"}}, "required": ["schema"]},
      "then": {
        "required": ["errors", "human_review_required"],
        "properties": {
          "status": {"const": "invalid_input"},
          "findings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "status", "severity", "message", "human_review_required"],
              "properties": {
                "id": {"const": "capability_maturity_input_invalid"},
                "status": {"const": "invalid_input"},
                "severity": {"const": "blocking"},
                "message": {"type": "string"},
                "human_review_required": {"const": true}
              },
              "additionalProperties": false
            }
          }
        },
        "not": {"anyOf": [{"required": ["summary"]}, {"required": ["capabilities"]}, {"required": ["state"]}]}
      },
      "else": {
        "required": ["generated_at", "profile", "naos_root", "project_root", "state", "policy",
                     "semantics", "summary", "related_evidence", "capabilities", "limitations"],
        "properties": {"status": {"not": {"const": "invalid_input"}}},
        "not": {"anyOf": [{"required": ["errors"]}, {"required": ["human_review_required"]}]}
      }
    }
  ],
  "properties": {
    "schema": {"enum": ["naos.capability_maturity.v1", "naos.capability_maturity_input_error.v1"]},
    "errors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "human_review_required": {"const": true},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "source"],
      "properties": {
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "source": {"type": "string", "enum": ["project", "missing"]}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "path"],
      "properties": {
        "version": {"type": ["string", "number", "null"]},
        "source": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "report", "promotion", "flow"],
      "properties": {
        "state": {"type": "string"},
        "report": {"type": "string"},
        "promotion": {"type": "string"},
        "flow": {"type": "string"}
      }
    },
    "status": {"type": "string"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocking",
        "required",
        "warnings",
        "advisory",
        "total_findings",
        "capabilities",
        "enabled",
        "disabled",
        "not_configured",
        "unknown",
        "ready",
        "blocked",
        "advisory_status",
        "ready_for_promotion",
        "human_approval_required",
        "promotion_recorded",
        "waivers"
      ],
      "properties": {
        "blocking": {"type": "integer", "minimum": 0},
        "required": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0},
        "total_findings": {"type": "integer", "minimum": 0},
        "capabilities": {"type": "integer", "minimum": 0},
        "enabled": {"type": "integer", "minimum": 0},
        "disabled": {"type": "integer", "minimum": 0},
        "not_configured": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "ready": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "advisory_status": {"type": "integer", "minimum": 0},
        "ready_for_promotion": {"type": "integer", "minimum": 0},
        "human_approval_required": {"type": "integer", "minimum": 0},
        "promotion_recorded": {"type": "integer", "minimum": 0},
        "waivers": {"type": "integer", "minimum": 0}
      }
    },
    "related_evidence": {"type": "object"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_results": {"type": "array", "items": {"$ref": "#/$defs/maturity_evidence_result"}},
          "unresolved_evidence": {"type": "array", "items": {"type": "string"}},
          "evidence_basis": {"enum": ["none", "manual", "automatic", "mixed"]}
        },
        "required": [
          "capability_id",
          "current_maturity",
          "target_maturity",
          "evaluated_status",
          "enabled",
          "ready_for_promotion",
          "human_approval_required"
        ]
      }
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "maturity_evidence_result": {
      "type": "object",
      "required": ["reference", "stage", "availability", "validation", "requirement_outcome", "generation_age", "claim_ceiling"],
      "properties": {
        "reference": {"type": "string"},
        "stage": {"enum": ["L2", "L3", "L4"]},
        "availability": {"type": "string"},
        "validation": {"type": "string"},
        "requirement_outcome": {"type": "string"},
        "generation_age": {
          "type": "object",
          "required": ["status", "basis", "timestamp"],
          "properties": {
            "status": {"enum": ["within_window", "stale", "unknown", "not_enforced"]},
            "basis": {"type": "string"},
            "timestamp": {"type": ["string", "null"]}
          }
        },
        "claim_ceiling": {"type": "string"},
        "requirement_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "optional", "require_current_source", "freshness_window_days"],
          "properties": {
            "type": {"enum": ["report", "manual"]},
            "optional": {"type": "boolean"},
            "require_current_source": {"type": "boolean"},
            "freshness_window_days": {"type": "integer", "minimum": 0}
          }
        },
        "signal_tracking": {"enum": ["current_selected_projection", "unresolved"]},
        "measurement_assurance": {"const": "not_established"}
      }
    }
  }
}
