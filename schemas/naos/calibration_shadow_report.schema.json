{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:calibration_shadow_report:v1",
  "title": "NAOS Calibration Shadow Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "calibration_config_path",
    "calibration_config_present",
    "calibration_config_valid",
    "reports_checked",
    "reports_missing",
    "schema_matches",
    "status_matches",
    "finding_id_matches",
    "source_category_matches",
    "summary_count_matches",
    "calibration_drift",
    "drift_count",
    "unexpected_changes",
    "ignored_fields",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.calibration_shadow_report.v1"},
    "generated_at": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"enum": ["ready", "advisory", "review_required", "missing_config", "invalid_config", "missing_reports", "drift_detected", "blocked", "unknown"]},
    "naos_root": {"type": "string"},
    "calibration_config_path": {"type": "string"},
    "calibration_config_present": {"type": "boolean"},
    "calibration_config_valid": {"type": "boolean"},
    "reports_checked": {"type": "array", "items": {"type": "object"}},
    "reports_missing": {"type": "array", "items": {"type": "object"}},
    "schema_matches": {"type": "array", "items": {"type": "object"}},
    "status_matches": {"type": "array", "items": {"type": "object"}},
    "finding_id_matches": {"type": "array", "items": {"type": "object"}},
    "source_category_matches": {"type": "array", "items": {"type": "object"}},
    "summary_count_matches": {"type": "array", "items": {"type": "object"}},
    "calibration_drift": {"type": "array", "items": {"type": "object"}},
    "drift_count": {"type": "integer", "minimum": 0},
    "unexpected_changes": {"type": "array", "items": {"type": "object"}},
    "ignored_fields": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  }
}
