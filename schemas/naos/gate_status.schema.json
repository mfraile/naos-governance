{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:gate_status:v1",
  "title": "NAOS Gate Status Report",
  "description": "Schema for the current gate status report shape emitted by scripts/naos_gate_status.py. The report is governance visibility only and is not approval, certification, attestation, release authorization, or proof of compliance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "manifest",
    "manifest_source",
    "team_id",
    "team_resolution_source",
    "team_gatekeeper_overrides_enabled",
    "team_operator_map_path",
    "team_operator_map_present",
    "operator_id",
    "operator_source",
    "team_overrides_applied",
    "team_overrides_rejected",
    "effective_gatekeepers",
    "base_gatekeepers",
    "override_summary",
    "protected_invariant_violations",
    "team_override_findings",
    "findings",
    "summary",
    "gates",
    "limitations",
    "not_claimed",
    "human_review_required"
  ],
  "properties": {
    "schema": {"const": "naos.gate_status.v1"},
    "evaluation_scope": {"type": "object", "additionalProperties": false, "required": ["status", "selected_count"], "properties": {"status": {"enum": ["empty", "not_applicable", "evaluated"]}, "selected_count": {"type": "integer", "minimum": 0}}},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "manifest": {"type": "string"},
    "manifest_source": {"type": "string", "enum": ["explicit", "project", "template"]},
    "team_id": {"type": ["string", "null"]},
    "team_resolution_source": {"type": "string"},
    "team_gatekeeper_overrides_enabled": {"type": "boolean"},
    "team_operator_map_path": {"type": "string"},
    "team_operator_map_present": {"type": "boolean"},
    "operator_id": {"type": ["string", "null"]},
    "operator_source": {"type": ["string", "null"]},
    "team_overrides_applied": {"type": "array", "items": {"type": "object"}},
    "team_overrides_rejected": {"type": "array", "items": {"type": "object"}},
    "effective_gatekeepers": {"type": "array", "items": {"type": "object"}},
    "base_gatekeepers": {"type": "array", "items": {"type": "object"}},
    "override_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "team_id",
        "team_resolution_source",
        "team_overrides_applied",
        "team_overrides_rejected",
        "severity_downgrades",
        "enabled_changes"
      ],
      "properties": {
        "team_id": {"type": ["string", "null"]},
        "team_resolution_source": {"type": "string"},
        "team_overrides_applied": {"type": "integer", "minimum": 0},
        "team_overrides_rejected": {"type": "integer", "minimum": 0},
        "severity_downgrades": {"type": "integer", "minimum": 0},
        "enabled_changes": {"type": "integer", "minimum": 0}
      }
    },
    "protected_invariant_violations": {"type": "array", "items": {"type": "object"}},
    "team_override_findings": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "capability_maturity": {"type": "object"},
    "systemic_impact_review": {"type": "object"},
    "module_header_traceability": {"type": "object"},
    "spec_pack_contract": {"type": "object"},
    "spec_cascade_coherence": {"type": "object"},
    "control_plane_review": {"type": "object"},
    "setup_recommendations": {"type": "object"},
    "evidence_attestation": {"type": "object"},
    "evidence_conflicts": {"type": "object"},
    "task_claims": {"type": "object"},
    "memory_context_readiness": {"type": "object"},
    "memory_provider_access": {"type": "object"},
    "memory_use_policy": {"type": "object"},
    "task_context_pack": {"type": "object"},
    "task_lifecycle": {"type": "object"},
    "research_record": {"type": "object"},
    "composed_traceability": {"type": "object"},
    "local_context_index": {"type": "object"},
    "sqlite_write_coordination": {"type": "object"},
    "local_context_query": {"type": "object"},
    "semantic_candidate_layer": {"type": "object"},
    "graph_context_readiness": {"type": "object"},
    "graph_context_query": {"type": "object"},
    "session_identity": {"type": "object"},
    "operator_attribution": {"type": "object"},
    "session_lifecycle": {"type": "object"},
    "audit_log": {"type": "object"},
    "agent_trace_validation": {"type": "object"},
    "ai_surface_health": {"type": "object"},
    "static_grader": {"type": "object"},
    "grader_assessment": {"type": "object"},
    "llm_grader_readiness": {"type": "object"},
    "behavioral_governance_readiness": {"type": "object"},
    "policy_overrides": {"type": "object"},
    "pr_risk_classification": {"type": "object"},
    "package_reality": {"type": "object"},
    "agentic_workflow_review": {"type": "object"},
    "pre_implementation_alignment_review": {"type": "object"},
    "agentic_workflow_config": {"type": "object"},
    "pre_implementation_alignment_artifact": {"type": "object"},
    "calibration_shadow": {"type": "object"},
    "evidence_classification": {"type": "object"},
    "failure_mode_observations": {"type": "object"},
    "cross_harness_review_readiness": {"type": "object"},
    "governance_bypass_posture": {"type": "object"},
    "external_evidence_ingest": {"type": "object"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "blocked",
        "required_missing",
        "warning",
        "advisory_missing",
        "not_applicable",
        "total"
      ],
      "properties": {
        "ready": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "required_missing": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "advisory_missing": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "audit_log_event": {"type": "object"},
    "selected_gates": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "severity",
        "enabled",
        "base_gatekeeper",
        "effective_gatekeeper",
        "original_severity",
        "effective_severity",
        "original_enabled",
        "effective_enabled",
        "team_id",
        "team_resolution_source",
        "team_override_applied",
        "team_override_source",
        "team_override_rationale",
        "team_override_fields_applied",
        "team_override_findings",
        "team_overrides_rejected",
        "limitations",
        "not_claimed",
        "human_review_required",
        "missing_inputs",
        "missing_evidence",
        "semantic_evidence",
        "validators",
        "experimental",
        "maturity_dependency",
        "known_limitations"
      ],
      "properties": {
        "id": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["ready", "blocked", "required_missing", "warning", "advisory_missing", "not_applicable", "unknown"]},
        "severity": {"type": "string", "enum": ["none", "advisory", "warning", "required", "blocking"]},
        "enabled": {"type": "boolean"},
        "base_gatekeeper": {"$ref": "#/$defs/gatekeeper_posture"},
        "effective_gatekeeper": {"type": "object"},
        "original_severity": {"type": "string"},
        "effective_severity": {"type": "string"},
        "original_enabled": {"type": "boolean"},
        "effective_enabled": {"type": "boolean"},
        "team_id": {"type": ["string", "null"]},
        "team_resolution_source": {"type": "string"},
        "team_override_applied": {"type": "boolean"},
        "team_override_source": {"type": ["string", "null"]},
        "team_override_rationale": {"type": ["string", "null"]},
        "team_override_fields_applied": {"type": "array", "items": {"type": "string"}},
        "team_override_findings": {"type": "array", "items": {"type": "object"}},
        "team_overrides_rejected": {"type": "array", "items": {"type": "object"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "not_claimed": {"type": "array", "items": {"type": "string"}},
        "human_review_required": {"type": "boolean"},
        "missing_inputs": {"type": "array", "items": {"type": "string"}},
        "missing_evidence": {"type": "array", "items": {"type": "string"}},
        "semantic_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "source", "field", "allowed_values", "actual_value", "status"],
            "properties": {
              "id": {"type": "string"},
              "source": {"type": "string"},
              "field": {"type": "string"},
              "allowed_values": {"type": "array", "items": {"type": "string"}},
              "actual_value": {},
              "status": {"enum": ["pass", "failed", "source_error"]}
            }
          }
        },
        "validators": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "planned", "manual", "external", "unknown"],
          "properties": {
            "available": {"type": "integer", "minimum": 0},
            "planned": {"type": "integer", "minimum": 0},
            "manual": {"type": "integer", "minimum": 0},
            "external": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0}
          }
        },
        "experimental": {"type": "boolean"},
        "maturity_dependency": {"type": "object"},
        "maturity_gated": {"type": "boolean"},
        "pre_maturity_severity": {"type": "string"},
        "known_limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gatekeeper_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "enabled"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "severity": {"type": "string"},
        "enabled": {"type": "boolean"}
      }
    }
  }
}
