{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:graph_context_query:v1",
  "title": "NAOS Graph Context Query Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "graph_readiness_report_path",
    "local_context_index_report_path",
    "local_context_query_report_path",
    "sqlite_artifact",
    "sqlite_artifact_exists",
    "seed",
    "seed_type",
    "query",
    "query_mode_requested",
    "query_mode_used",
    "depth_requested",
    "depth_used",
    "limit",
    "link_type_filter",
    "allowed_link_types",
    "prohibited_link_types",
    "traversal_limits",
    "seed_nodes",
    "results",
    "result_count",
    "truncated",
    "authority_summary",
    "freshness_summary",
    "source_index",
    "graph_context_readiness",
    "findings",
    "known_gaps",
    "residual_risks",
    "waivers",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.graph_context_query.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ready", "advisory", "review_required", "not_configured", "missing_index", "blocked", "unknown"]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "graph_readiness_report_path": { "type": "string" },
    "local_context_index_report_path": { "type": "string" },
    "local_context_query_report_path": { "type": "string" },
    "query": { "type": "object" },
    "seed": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } },
        { "type": "null" }
      ]
    },
    "seed_type": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": ["string", "null"] } },
        { "type": "null" }
      ]
    },
    "query_mode_requested": { "type": "array", "items": { "type": "string" } },
    "query_mode_used": { "type": "array", "items": { "type": "string" } },
    "depth_requested": { "type": "integer" },
    "depth_used": { "type": "integer" },
    "traversal_depth_requested": { "type": "integer" },
    "traversal_depth_used": { "type": "integer" },
    "limit": { "type": "integer" },
    "link_type_filter": { "type": ["string", "null"] },
    "traversal_limits": { "type": "object" },
    "allowed_link_types": { "type": "array", "items": { "type": "string" } },
    "prohibited_link_types": { "type": "array", "items": { "type": "string" } },
    "seed_nodes": { "type": "array", "items": { "type": "object" } },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "rank",
          "relationship_path",
          "depth",
          "link_type",
          "reference_id",
          "source_artifact_id",
          "source_path",
          "source_artifact_type",
          "source_authority_level",
          "source_hash",
          "source_freshness_status",
          "target_artifact_id",
          "target_path",
          "target_artifact_type",
          "target_authority_level",
          "target_hash",
          "target_freshness_status",
          "provenance",
          "confidence",
          "review_status",
          "limitations",
          "not_claimed"
        ],
        "properties": {
          "rank": { "type": "integer" },
          "relationship_path": { "type": "array", "items": { "type": "object" } },
          "depth": { "type": "integer" },
          "link_type": { "type": ["string", "null"] },
          "reference_id": { "type": ["string", "null"] },
          "source_artifact_id": { "type": ["string", "null"] },
          "source_path": { "type": ["string", "null"] },
          "source_artifact_type": { "type": ["string", "null"] },
          "source_authority_level": { "type": ["string", "null"] },
          "source_hash": { "type": ["string", "null"] },
          "source_freshness_status": { "type": ["string", "null"] },
          "target_artifact_id": { "type": ["string", "null"] },
          "target_path": { "type": ["string", "null"] },
          "target_artifact_type": { "type": ["string", "null"] },
          "target_authority_level": { "type": ["string", "null"] },
          "target_hash": { "type": ["string", "null"] },
          "target_freshness_status": { "type": ["string", "null"] },
          "provenance": { "type": ["string", "null"] },
          "confidence": { "type": ["string", "null"] },
          "review_status": { "type": ["string", "null"] },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "not_claimed": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "result_count": { "type": "integer" },
    "truncated": { "type": "boolean" },
    "bounded_result_limit": { "type": "integer" },
    "authority_summary": { "type": "object" },
    "freshness_summary": { "type": "object" },
    "source_artifacts": { "type": "array", "items": { "type": "object" } },
    "source_index": { "type": "object" },
    "sqlite_artifact": { "type": "object" },
    "sqlite_artifact_exists": { "type": "boolean" },
    "graph_context_readiness": { "type": "object" },
    "local_context_query_context": { "type": "object" },
    "task_context_pack_context": { "type": "object" },
    "semantic_candidate_layer_readiness": { "type": "object" },
    "memory_policy": { "type": "object" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "known_gaps": { "type": "array", "items": { "type": "object" } },
    "residual_risks": { "type": "array", "items": { "type": "object" } },
    "waivers": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "not_claimed": { "type": "array", "items": { "type": "string" } },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  }
}
