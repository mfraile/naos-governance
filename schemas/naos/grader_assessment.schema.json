{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:grader_assessment:v1",
  "title": "NAOS Grader Assessment Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "mode",
    "naos_root",
    "project_root",
    "runner",
    "runner_version",
    "static_grader",
    "conformance",
    "deterministic_results",
    "advisory_results",
    "not_evaluated_dimensions",
    "llm_readiness",
    "drift",
    "cost_budget_posture",
    "cadence_posture",
    "input_reports",
    "baseline",
    "current",
    "dimensions",
    "dimension_summary",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.grader_assessment.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "advisory",
        "review_required",
        "missing_trace",
        "missing_static_grader_report",
        "missing_baseline",
        "stale_baseline",
        "invalid_baseline",
        "drift_detected",
        "no_drift_detected",
        "not_configured",
        "blocked",
        "unknown"
      ]
    },
    "mode": {"type": "string", "enum": ["audit", "drift", "assess"]},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "runner": {"type": "string"},
    "runner_version": {"type": "string"},
    "static_grader": {"type": "object", "additionalProperties": true},
    "conformance": {"type": "object", "additionalProperties": true},
    "deterministic_results": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "advisory_results": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "not_evaluated_dimensions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "llm_readiness": {"$ref": "#/$defs/llm_readiness"},
    "ai_surface_health_posture": {"type": "object", "additionalProperties": true},
    "drift": {"$ref": "#/$defs/drift"},
    "cost_budget_posture": {"$ref": "#/$defs/cost_budget_posture"},
    "cadence_posture": {"type": "object", "additionalProperties": true},
    "input_reports": {"type": "array", "items": {"$ref": "#/$defs/input_report"}},
    "baseline": {"type": "object", "additionalProperties": true},
    "current": {"type": "object", "additionalProperties": true},
    "dimensions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "dimension_summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "input_report": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "present"],
      "properties": {
        "id": {"type": "string"},
        "path": {"type": "string"},
        "present": {"type": "boolean"},
        "status": {"type": ["string", "null"]},
        "schema": {"type": ["string", "null"]},
        "generated_at": {"type": ["string", "null"]},
        "findings_count": {"type": "integer", "minimum": 0}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "status", "message"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"type": "string"},
        "status": {"type": "string"},
        "message": {"type": "string"},
        "source": {"type": "string"},
        "dimension_id": {"type": "string"},
        "human_review_required": {"type": "boolean"}
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_report_path",
        "baseline_hash",
        "current_report_hash",
        "baseline_generated_at",
        "current_generated_at",
        "changed_dimensions",
        "new_findings",
        "resolved_findings",
        "unchanged_findings",
        "stale_baseline_warning",
        "no_semantic_drift_inferred"
      ],
      "properties": {
        "baseline_report_path": {"type": ["string", "null"]},
        "baseline_hash": {"type": ["string", "null"]},
        "current_report_hash": {"type": "string"},
        "baseline_generated_at": {"type": ["string", "null"]},
        "current_generated_at": {"type": ["string", "null"]},
        "changed_dimensions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "new_findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "resolved_findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "unchanged_findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "stale_baseline_warning": {"type": "boolean"},
        "no_semantic_drift_inferred": {"const": true}
      }
    },
    "cost_budget_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_usd",
        "cost_incurred_by_default",
        "external_api_required",
        "provider_allowed",
        "provider_dependency_required",
        "model_dependency_required",
        "llm_runtime_enabled",
        "max_cost_usd",
        "max_runs_per_day",
        "cadence",
        "manual_approval_required",
        "human_approval_required_before_cost",
        "data_exposure_level",
        "audit_window",
        "baseline_reference"
      ],
      "properties": {
        "cost_usd": {"type": "number", "minimum": 0},
        "cost_incurred_by_default": {"type": "boolean"},
        "external_api_required": {"type": "boolean"},
        "provider_allowed": {"type": "boolean"},
        "provider_dependency_required": {"type": "boolean"},
        "model_dependency_required": {"type": "boolean"},
        "llm_runtime_enabled": {"type": "boolean"},
        "max_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "max_runs_per_day": {"type": ["integer", "null"], "minimum": 0},
        "cadence": {"type": ["string", "null"]},
        "manual_approval_required": {"type": "boolean"},
        "human_approval_required_before_cost": {"type": "boolean"},
        "data_exposure_level": {"type": ["string", "null"]},
        "audit_window": {"type": ["string", "null"]},
        "baseline_reference": {"type": ["string", "null"]}
      }
    },
    "llm_readiness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "runtime_enabled",
        "provider_dependency_required",
        "model_dependency_required",
        "external_api_required",
        "cost_incurred_by_default",
        "future_enablement_requires",
        "future_output_authority"
      ],
      "properties": {
        "runtime_enabled": {"const": false},
        "provider_dependency_required": {"type": "boolean"},
        "model_dependency_required": {"type": "boolean"},
        "external_api_required": {"type": "boolean"},
        "cost_incurred_by_default": {"type": "boolean"},
        "future_enablement_requires": {"type": "array", "items": {"type": "string"}},
        "future_output_authority": {"type": "string"}
      }
    }
  }
}
