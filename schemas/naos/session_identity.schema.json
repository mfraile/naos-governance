{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:session_identity:v1",
  "title": "NAOS Session Identity Report",
  "description": "Report describing session-id creation or reuse, local operator attribution signals, and latest-report compatibility. It is not authentication, authorization, task locking, an audit log, separation-of-duties evidence, or proof of multi-user safety.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "session_id",
    "session_root",
    "session_report_root",
    "sessions_index_path",
    "generated_by",
    "operator_attribution",
    "latest_report_compatibility",
    "session_aware_reports",
    "latest_only_reports",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"type": "string", "const": "naos.session_identity.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string"},
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "advisory",
        "session_created",
        "session_reused",
        "invalid_session_id",
        "index_updated",
        "index_write_failed",
        "not_configured",
        "blocked",
        "unknown"
      ]
    },
    "session_id": {"type": ["string", "null"]},
    "session_root": {"type": ["string", "null"]},
    "session_report_root": {"type": ["string", "null"]},
    "sessions_index_path": {"type": ["string", "null"]},
    "generated_by": {"type": "object"},
    "operator_attribution": {"type": "object"},
    "latest_report_compatibility": {"type": "object"},
    "session_aware_reports": {"type": "array", "items": {"type": "string"}},
    "latest_only_reports": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  }
}
