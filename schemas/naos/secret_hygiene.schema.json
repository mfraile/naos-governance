{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:secret_hygiene:v1",
  "title": "NAOS Secret Hygiene Report",
  "description": "Deterministic secret-hygiene report. Findings are review evidence only and are not secret-free proof, approval, certification, or replacement for dedicated secret scanning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "project_root",
    "naos_root",
    "rules_path",
    "deterministic",
    "cost_posture",
    "summary",
    "scans",
    "findings",
    "waivers",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required"
  ],
  "properties": {
    "schema": {
      "const": "naos.secret_hygiene.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "profile": {
      "type": "string",
      "enum": [
        "quickstart",
        "lite",
        "standard",
        "assured"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "advisory",
        "warning",
        "required_missing",
        "blocked"
      ]
    },
    "project_root": {
      "type": "string"
    },
    "naos_root": {
      "type": "string"
    },
    "rules_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "deterministic": {
      "type": "boolean"
    },
    "cost_posture": {
      "$ref": "#/$defs/cost_posture"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "public_literal_matches": {
          "type": "integer",
          "minimum": 0
        },
        "unassessed_suffix_files": {
          "type": "integer",
          "minimum": 0
        },
        "discovered_excluded_directories": {
          "type": "integer",
          "minimum": 0
        },
        "discovery_errors": {
          "type": "integer",
          "minimum": 0
        },
        "inline_waivers": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed_findings": {
          "type": "integer",
          "minimum": 0
        },
        "discovered_unselected_files": {
          "type": "integer",
          "minimum": 0
        },
        "discovered_excluded_files": {
          "type": "integer",
          "minimum": 0
        },
        "unselected_root_directories": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_root_directories": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_operand_matches": {
          "type": "integer",
          "minimum": 0
        },
        "instruction_aliases": {
          "type": "integer",
          "minimum": 0,
          "description": "Supported direct root instruction aliases linked to stable already-scanned targets; these are not additional file reads."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of selected regular-file reads successfully analyzed; excludes aliases."
        }
      }
    },
    "scans": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "coverage_basis": {
          "const": "selected_files_only"
        },
        "public_literals": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "valid",
                "invalid"
              ]
            },
            "schema": {
              "const": "naos.secret_public_literals.v1"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "declarations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "context_values": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "kit_root_basis": {
              "const": "executing_module_location"
            },
            "enrollment_uuid": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "runtime_layout": {
              "enum": [
                "kit",
                "copied_project"
              ]
            }
          }
        },
        "inventory_operand_proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "status",
              "matches",
              "proof_bytes"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "proved",
                  "partial_refusal",
                  "refused"
                ]
              },
              "matches": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65536
              },
              "proof_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 33554432,
                "description": "Conservatively charged managed proof bytes, including reservations retained after refused reads; stable cached reuse is uncharged."
              },
              "reason": {
                "type": "string"
              },
              "refusals": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "family",
                    "reason"
                  ],
                  "properties": {
                    "family": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inline_waiver"
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_claimed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "type": "boolean"
    }
  },
  "$defs": {
    "cost_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_incurred_by_default",
        "cost_usd",
        "external_api_required",
        "provider_dependency_required",
        "model_dependency_required",
        "human_approval_required_before_cost"
      ],
      "properties": {
        "cost_incurred_by_default": {
          "type": "boolean"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "external_api_required": {
          "type": "boolean"
        },
        "provider_dependency_required": {
          "type": "boolean"
        },
        "model_dependency_required": {
          "type": "boolean"
        },
        "human_approval_required_before_cost": {
          "type": "boolean"
        }
      }
    },
    "inline_waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "rule_counts",
        "suppressed_findings",
        "human_review_required",
        "scope"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "rule_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assigned_secret": {
              "type": "integer",
              "minimum": 1
            },
            "high_entropy": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "suppressed_findings": {
          "type": "integer",
          "minimum": 0
        },
        "human_review_required": {
          "const": true
        },
        "scope": {
          "const": [
            "assigned_secret",
            "high_entropy"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "severity",
        "status",
        "message",
        "human_review_required",
        "not_claimed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "human_review_required": {
          "type": "boolean"
        },
        "not_claimed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
