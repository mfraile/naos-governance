{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:ui_experience_quality:v1",
  "title": "NAOS UI Experience Quality Review Report",
  "description": "Deterministic local review evidence for optional UI/UX quality evidence declarations. It is not design quality proof, user delight proof, brand approval, accessibility certification, privacy compliance determination, Figma/MCP sync, approval, certification, attestation, proof of compliance, release authority, publication authority, runtime orchestration, provider calls, model calls, or memory activation.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "deterministic",
    "declaration_path",
    "declaration_source",
    "enabled",
    "ui_quality_declared",
    "design_stage",
    "runtime_enabled",
    "mcp_allowed",
    "figma_api_allowed",
    "browser_automation_allowed",
    "design_tool_calls_allowed",
    "external_generator_authority",
    "model_judgement_authority",
    "tool_mutation_allowed",
    "capability_maturity",
    "screens",
    "evidence_refs",
    "findings",
    "reason_code_counts",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "generated_by",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.ui_experience_quality.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {
      "type": "string",
      "enum": ["pass", "advisory", "warning", "required_missing", "blocked", "not_configured", "unknown"]
    },
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "deterministic": {"const": true},
    "declaration_path": {"type": "string"},
    "declaration_source": {"type": "string", "enum": ["project", "template", "explicit"]},
    "declaration_hash": {"type": ["string", "null"]},
    "enabled": {"type": "boolean"},
    "ui_quality_declared": {"type": "boolean"},
    "design_stage": {
      "type": "string",
      "enum": ["concept_exploration", "wireframe_or_prototype", "implementation_ready_design", "post_implementation_review"]
    },
    "runtime_enabled": {"const": false},
    "mcp_allowed": {"const": false},
    "figma_api_allowed": {"const": false},
    "browser_automation_allowed": {"const": false},
    "design_tool_calls_allowed": {"const": false},
    "external_generator_authority": {"const": false},
    "model_judgement_authority": {"const": false},
    "tool_mutation_allowed": {"const": false},
    "capability_maturity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["current", "assured_blocking_enabled", "blocking_requires_l3_plus_and_gate_wiring"],
      "properties": {
        "current": {"type": "string"},
        "assured_blocking_enabled": {"const": false},
        "blocking_requires_l3_plus_and_gate_wiring": {"const": true}
      }
    },
    "profile_posture": {"type": "object"},
    "stage_counts": {"type": "object"},
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "index",
          "object_id",
          "design_stage",
          "fr_refs",
          "nfr_refs",
          "task_refs",
          "acceptance_criteria_refs",
          "data_model_refs",
          "api_contract_refs",
          "state_model_refs",
          "open_dependency_questions",
          "state_coverage",
          "responsive_breakpoints",
          "screenshot_sets",
          "human_review_required",
          "residual_risks",
          "non_claims"
        ],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "object_id": {"type": ["string", "null"]},
          "design_stage": {"type": "string"},
          "fr_refs": {"type": "array", "items": {"type": "string"}},
          "nfr_refs": {"type": "array", "items": {"type": "string"}},
          "task_refs": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria_refs": {"type": "array", "items": {"type": "string"}},
          "data_model_refs": {"type": "array", "items": {"type": "string"}},
          "api_contract_refs": {"type": "array", "items": {"type": "string"}},
          "state_model_refs": {"type": "array", "items": {"type": "string"}},
          "open_dependency_questions": {"type": "array", "items": {"type": "string"}},
          "state_coverage": {"type": "array", "items": {"type": "string"}},
          "responsive_breakpoints": {"type": "array", "items": {"type": "string"}},
          "screenshot_sets": {"type": "array", "items": {"type": "object"}},
          "human_review_required": {"type": "boolean"},
          "review_disposition": {},
          "residual_risks": {"type": "array", "items": {"type": "string"}},
          "non_claims": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "severity", "status", "reason_code", "gate", "message", "human_review_required"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["advisory", "warning", "required", "blocking"]},
          "status": {"type": "string"},
          "reason_code": {"type": "string"},
          "related_gates": {"type": "array", "items": {"type": "string"}},
          "gate": {"type": "string"},
          "message": {"type": "string"},
          "human_review_required": {"type": "boolean"}
        }
      }
    },
    "reason_code_counts": {"type": "object"},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {
      "type": "array",
      "items": {"type": "string"},
      "allOf": [
        {"contains": {"const": "design quality proof"}},
        {"contains": {"const": "accessibility certification"}},
        {"contains": {"const": "approval"}},
        {"contains": {"const": "merge approval"}},
        {"contains": {"const": "proof of compliance"}},
        {"contains": {"const": "certification"}},
        {"contains": {"const": "attestation"}},
        {"contains": {"const": "runtime orchestration"}},
        {"contains": {"const": "MCP activation"}},
        {"contains": {"const": "provider calls"}},
        {"contains": {"const": "model calls"}},
        {"contains": {"const": "memory activation"}}
      ]
    },
    "human_review_required": {"type": "boolean"},
    "generated_by": {"type": "object", "additionalProperties": true},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "blocking": {"type": "integer", "minimum": 0},
        "required": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0},
        "total_findings": {"type": "integer", "minimum": 0},
        "screens": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "integer", "minimum": 0},
        "evidence_refs_missing": {"type": "integer", "minimum": 0},
        "assured_blocking_enabled": {"const": 0}
      }
    }
  }
}
