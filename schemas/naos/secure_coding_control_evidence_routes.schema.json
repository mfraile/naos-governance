{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:secure-coding-control-evidence-routes:v1",
  "title": "NAOS Secure-Coding Control Evidence Routes",
  "description": "Detector-to-evidence routing contract. It routes bounded review evidence and does not own enforcement or control satisfaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "semantics",
    "register_path",
    "report_path",
    "routes"
  ],
  "properties": {
    "schema": {
      "const": "naos.secure_coding_control_evidence_routes.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "active"
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "authority",
        "evidence",
        "staleness_source",
        "not_claimed"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "staleness_source": {
          "type": "string",
          "minLength": 1
        },
        "not_claimed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "register_path": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.ya?ml$"
    },
    "report_path": {
      "type": "string",
      "pattern": "^reports/[^/]+\\.json$"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detector_id",
          "evidence_path",
          "evidence_kind",
          "requirement",
          "minimum_profile",
          "applies_when",
          "gates",
          "boundary"
        ],
        "properties": {
          "detector_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "evidence_path": {
            "type": "string",
            "pattern": "^reports/[^/]+\\.json$"
          },
          "evidence_kind": {
            "type": "string",
            "enum": [
              "deterministic_local",
              "unverified_external"
            ]
          },
          "requirement": {
            "type": "string",
            "enum": [
              "required",
              "conditional",
              "optional"
            ]
          },
          "minimum_profile": {
            "type": "string",
            "enum": [
              "quickstart",
              "lite",
              "standard",
              "assured"
            ]
          },
          "applies_when": {
            "type": "string",
            "enum": [
              "always",
              "pull_request",
              "external_evidence_supplied"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^G[0-9]+$"
            }
          },
          "boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
