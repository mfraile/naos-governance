{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:local_context_index:v1",
  "title": "NAOS Local Context Index Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "rules_path",
    "rules_hash",
    "sqlite_artifact",
    "sqlite_version",
    "fts_available",
    "fts_query_sanitization",
    "source_families",
    "indexed_artifacts",
    "excluded_artifacts",
    "artifact_type_counts",
    "authority_level_counts",
    "chunk_counts",
    "link_counts",
    "freshness_summary",
    "memory_policy",
    "future_semantic_layer",
    "future_graph_layer",
    "query_modes_supported",
    "task_context_pack_integration",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.local_context_index.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ready", "advisory", "review_required", "not_configured", "disabled", "blocked", "unknown"]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "rules_path": { "type": "string" },
    "rules_hash": { "type": ["string", "null"] },
    "sqlite_artifact": { "type": "object" },
    "sqlite_version": { "type": "string" },
    "fts_available": { "type": "boolean" },
    "fts_query_sanitization": { "type": "object" },
    "source_families": { "type": "array" },
    "indexed_artifacts": { "type": "array" },
    "excluded_artifacts": { "type": "array" },
    "artifact_type_counts": { "type": "object" },
    "authority_level_counts": { "type": "object" },
    "chunk_counts": { "type": "object" },
    "link_counts": { "type": "object" },
    "freshness_summary": { "type": "object" },
    "memory_policy": { "type": "object" },
    "future_semantic_layer": { "type": "object" },
    "future_graph_layer": { "type": "object" },
    "query_modes_supported": { "type": "object" },
    "task_context_pack_integration": { "type": "object" },
    "findings": { "type": "array" },
    "known_gaps": { "type": "array" },
    "residual_risks": { "type": "array" },
    "limitations": { "type": "array" },
    "not_claimed": { "type": "array" },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
