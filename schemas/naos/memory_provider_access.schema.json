{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:memory_provider_access:v1",
  "title": "NAOS Memory Provider / MCP Access Verification Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "rules_path",
    "rules_hash",
    "memory_config_path",
    "memory_rules_path",
    "authorization_matrix_path",
    "provider_declared",
    "provider_recommended",
    "provider_name",
    "provider_name_source",
    "provider_configured",
    "provider_access_verified",
    "provider_access_method",
    "provider_binary_detected",
    "provider_data_dir_declared",
    "provider_data_dir_effective",
    "provider_data_dir_source",
    "provider_data_dir_expansion_status",
    "provider_data_dir_exists",
    "provider_database_path",
    "provider_database_exists",
    "provider_storage_payload_read",
    "provider_replication_profile",
    "provider_replication_status",
    "provider_legacy_store_path_declared",
    "provider_legacy_store_path_status",
    "provider_store_path_declared",
    "provider_store_path_exists",
    "provider_store_payload_read",
    "mcp_config_files_inspected",
    "mcp_config_files_detected",
    "mcp_engram_config_files_detected",
    "mcp_configured",
    "mcp_servers_declared",
    "mcp_tools_declared",
    "mcp_other_servers_observed",
    "mcp_scan_scope",
    "mcp_access_verified",
    "project_identity",
    "platform_access_matrix",
    "authorization_matrix",
    "read_access",
    "draft_write_access",
    "approved_write_access",
    "admin_config_access",
    "ci_memory_access",
    "fallback_when_unavailable",
    "findings",
    "known_gaps",
    "residual_risks",
    "waivers",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.memory_provider_access.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "declared_only",
        "configured_unverified",
        "not_configured",
        "disabled",
        "readiness_only",
        "review_required",
        "blocked",
        "unknown"
      ]
    },
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "rules_path": {"type": "string"},
    "rules_hash": {"type": ["string", "null"]},
    "memory_config_path": {"type": ["string", "null"]},
    "memory_rules_path": {"type": ["string", "null"]},
    "authorization_matrix_path": {"type": ["string", "null"]},
    "provider_declared": {"type": "boolean"},
    "provider_recommended": {"type": "boolean"},
    "provider_name": {"type": ["string", "null"]},
    "provider_name_source": {
      "type": "string",
      "enum": ["configuration", "recommended_default"]
    },
    "provider_configured": {"type": "boolean"},
    "provider_access_verified": {"type": "boolean"},
    "provider_access_method": {"type": "string"},
    "provider_binary_detected": {"type": "boolean"},
    "provider_data_dir_declared": {"type": ["string", "null"]},
    "provider_data_dir_effective": {"type": "string"},
    "provider_data_dir_source": {"type": "string", "enum": ["environment", "config", "default"]},
    "provider_data_dir_expansion_status": {
      "type": "string",
      "enum": ["resolved", "invalid_user_home_reference"]
    },
    "provider_data_dir_exists": {"type": "boolean"},
    "provider_database_path": {"type": "string"},
    "provider_database_exists": {"type": "boolean"},
    "provider_storage_payload_read": {"const": false},
    "provider_replication_profile": {"type": "string", "minLength": 1},
    "provider_replication_status": {
      "type": "string",
      "enum": ["local", "unsafe_non_local"]
    },
    "provider_legacy_store_path_declared": {"type": ["string", "null"]},
    "provider_legacy_store_path_status": {
      "type": "string",
      "enum": ["absent", "deprecated_ambiguous_not_used"]
    },
    "provider_store_path_declared": {
      "type": ["string", "null"],
      "description": "Deprecated compatibility field containing only the legacy store_path declaration."
    },
    "provider_store_path_exists": {"type": "boolean"},
    "provider_store_payload_read": {"const": false},
    "mcp_config_files_inspected": {"type": "array", "items": {"type": "object"}},
    "mcp_config_files_detected": {"type": "array", "items": {"type": "object"}},
    "mcp_engram_config_files_detected": {"type": "array", "items": {"type": "object"}},
    "mcp_configured": {"type": "boolean"},
    "mcp_servers_declared": {"type": "array", "items": {"type": "object"}},
    "mcp_tools_declared": {"type": "array", "items": {"type": "object"}},
    "mcp_other_servers_observed": {"type": "array", "items": {"type": "object"}},
    "mcp_scan_scope": {
      "type": "object",
      "required": ["workspace_registry_metadata", "user_registry_metadata", "values_reported", "descriptor_ids"],
      "properties": {
        "workspace_registry_metadata": {"type": "boolean"},
        "user_registry_metadata": {"type": "boolean"},
        "values_reported": {"const": false},
        "descriptor_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "mcp_access_verified": {"type": "boolean"},
    "project_identity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "expected_project",
        "declared_project",
        "workspace_declarations",
        "user_declarations",
        "global_fixed_project_detected",
        "project_identity_verified",
        "provider_observed_project"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["missing", "declared_candidate", "declared_consistent", "conflict", "global_only", "unresolved_equivalence"]
        },
        "expected_project": {"type": ["string", "null"]},
        "declared_project": {"type": ["string", "null"]},
        "workspace_declarations": {"type": "array", "items": {"type": "object"}},
        "user_declarations": {"type": "array", "items": {"type": "object"}},
        "global_fixed_project_detected": {"type": "boolean"},
        "project_identity_verified": {"const": false},
        "provider_observed_project": {"type": ["string", "null"]}
      }
    },
    "platform_access_matrix": {"type": "array", "items": {"type": "object"}},
    "authorization_matrix": {"type": "object"},
    "read_access": {"type": "object"},
    "draft_write_access": {"type": "object"},
    "approved_write_access": {"type": "object"},
    "admin_config_access": {"type": "object"},
    "ci_memory_access": {"type": "object"},
    "fallback_when_unavailable": {"type": "object"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "known_gaps": {"type": "array", "items": {"type": "object"}},
    "residual_risks": {"type": "array", "items": {"type": "object"}},
    "waivers": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "status", "message"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"type": "string", "enum": ["none", "advisory", "warning", "required", "blocking"]},
        "status": {"type": "string"},
        "message": {"type": "string"},
        "required_next_actions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
