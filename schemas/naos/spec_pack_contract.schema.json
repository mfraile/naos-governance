{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:spec_pack_contract:v1",
  "title": "NAOS Spec-Pack Contract Report",
  "description": "Deterministic spec-pack template contract conformance report. Findings are bounded structural review evidence only and are not approval, requirements completeness proof, implementation proof, testing proof, certification, or compliance proof.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "mode",
    "project_root",
    "specs_root",
    "manifest",
    "deterministic",
    "summary",
    "findings",
    "files",
    "traceability_codes",
    "limitations",
    "not_claimed",
    "human_review_required"
  ],
  "properties": {
    "schema": {"const": "naos.spec_pack_contract.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"type": "string", "enum": ["pass", "advisory", "warning", "required_missing", "blocked"]},
    "mode": {"type": "string", "enum": ["structural", "filled"]},
    "project_root": {"type": "string"},
    "naos_root": {"type": "string"},
    "specs_root": {"type": "string"},
    "manifest": {"type": "string"},
    "deterministic": {"type": "boolean"},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "blocking",
        "required",
        "warnings",
        "advisory",
        "total_findings",
        "files_expected",
        "files_present",
        "files_missing",
        "contract_files_expected",
        "contract_files_present",
        "contract_files_missing",
        "spec_files_expected",
        "spec_files_present",
        "spec_files_missing",
        "support_files_expected",
        "support_files_present",
        "support_files_missing",
        "files_not_applicable",
        "section_findings",
        "pattern_findings",
        "marker_findings",
        "placeholder_findings",
        "traceability_reference_findings"
      ],
      "properties": {
        "blocking": {"type": "integer", "minimum": 0},
        "required": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0},
        "total_findings": {"type": "integer", "minimum": 0},
        "files_expected": {"type": "integer", "minimum": 0},
        "files_present": {"type": "integer", "minimum": 0},
        "files_missing": {"type": "integer", "minimum": 0},
        "contract_files_expected": {"type": "integer", "minimum": 0},
        "contract_files_present": {"type": "integer", "minimum": 0},
        "contract_files_missing": {"type": "integer", "minimum": 0},
        "spec_files_expected": {"type": "integer", "minimum": 0},
        "spec_files_present": {"type": "integer", "minimum": 0},
        "spec_files_missing": {"type": "integer", "minimum": 0},
        "support_files_expected": {"type": "integer", "minimum": 0},
        "support_files_present": {"type": "integer", "minimum": 0},
        "support_files_missing": {"type": "integer", "minimum": 0},
        "files_not_applicable": {"type": "integer", "minimum": 0},
        "files_not_applicable_present": {"type": "integer", "minimum": 0},
        "files_not_applicable_missing": {"type": "integer", "minimum": 0},
        "section_findings": {"type": "integer", "minimum": 0},
        "pattern_findings": {"type": "integer", "minimum": 0},
        "marker_findings": {"type": "integer", "minimum": 0},
        "placeholder_findings": {"type": "integer", "minimum": 0},
        "traceability_codes_required": {"type": "integer", "minimum": 0},
        "traceability_codes_not_applicable": {"type": "integer", "minimum": 0},
        "traceability_reference_findings": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "files": {"type": "array", "items": {"type": "object"}},
    "traceability_codes": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "status", "category", "message", "human_review_required", "not_claimed"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"type": "string", "enum": ["advisory", "warning", "required", "blocking"]},
        "status": {
          "type": "string",
          "enum": [
            "missing_file",
            "missing_section",
            "missing_pattern",
            "missing_marker",
            "placeholder_unresolved",
            "manifest_load_error",
            "invalid_manifest",
            "regex_error",
            "unresolved_reference",
            "missing_reference_source"
          ]
        },
        "category": {"type": "string"},
        "message": {"type": "string"},
        "path": {"type": "string"},
        "rule_id": {"type": "string"},
        "expected": {},
        "actual": {},
        "required_next_actions": {"type": "array", "items": {"type": "string"}},
        "human_review_required": {"type": "boolean"},
        "not_claimed": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
