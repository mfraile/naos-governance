{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:test_quality_hygiene:v1",
  "title": "NAOS Test Quality Hygiene Report",
  "description": "Deterministic test-quality hygiene report. Findings are review evidence only and are not behavioral correctness, coverage, runtime safety, approval, or certification proof.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "profile", "status", "project_root", "naos_root", "rules_path", "deterministic", "cost_posture", "summary", "scans", "findings", "waivers", "known_gaps", "residual_risks", "limitations", "not_claimed", "human_review_required"],
  "properties": {
    "schema": {"const": "naos.test_quality_hygiene.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"type": "string", "enum": ["pass", "advisory", "warning", "required_missing", "blocked"]},
    "project_root": {"type": "string"},
    "naos_root": {"type": "string"},
    "rules_path": {"type": ["string", "null"]},
    "deterministic": {"type": "boolean"},
    "cost_posture": {"$ref": "#/$defs/cost_posture"},
    "summary": {"type": "object", "additionalProperties": true, "properties": {
      "early_returns": {"type": "integer", "minimum": 0},
      "tests_with_effective_assertion": {"type": "integer", "minimum": 0},
      "tests_without_effective_assertion": {"type": "integer", "minimum": 0},
      "non_python_disable_markers": {"type": "integer", "minimum": 0},
      "discovery_errors": {"type": "integer", "minimum": 0},
      "skipped_tests": {"type": "integer", "minimum": 0},
      "dead_assertions": {"type": "integer", "minimum": 0},
      "swallowed_assertions": {"type": "integer", "minimum": 0},
      "unassessed_test_files": {"type": "integer", "minimum": 0},
      "trivial_assertions": {"type": "integer", "minimum": 0},
      "files_selected": {"type": "integer", "minimum": 0},
      "files_scanned": {"type": "integer", "minimum": 0},
      "files_failed": {"type": "integer", "minimum": 0},
      "parse_errors": {"type": "integer", "minimum": 0},
      "read_errors": {"type": "integer", "minimum": 0},
      "coverage_status": {"enum": ["complete", "incomplete", "not_configured"]}
    }},
    "scans": {"type": "object", "additionalProperties": true, "properties": {
      "non_python_assertion_coverage": {"const": "unassessed"},
      "non_python_marker_inputs": {"type": "array", "items": {
        "type": "object", "required": ["path", "status"], "additionalProperties": false,
        "properties": {"path": {"type": "string"}, "status": {"enum": ["marker_scanned", "size_limit", "read_error"]}}
      }},
      "unassessed_test_files": {"type": "array", "items": {"type": "string"}},
      "coverage_status": {"enum": ["complete", "incomplete", "not_configured"]},
      "input_files": {"type": "array", "items": {
        "type": "object", "required": ["path", "status"], "additionalProperties": false,
        "properties": {"path": {"type": "string"}, "status": {"enum": ["parsed", "parse_error", "read_error"]}}
      }}
    }},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "waivers": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"}
  },
  "$defs": {
    "cost_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost_incurred_by_default", "cost_usd", "external_api_required", "provider_dependency_required", "model_dependency_required", "human_approval_required_before_cost"],
      "properties": {
        "cost_incurred_by_default": {"type": "boolean"},
        "cost_usd": {"type": "number", "minimum": 0},
        "external_api_required": {"type": "boolean"},
        "provider_dependency_required": {"type": "boolean"},
        "model_dependency_required": {"type": "boolean"},
        "human_approval_required_before_cost": {"type": "boolean"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "status", "message", "human_review_required", "not_claimed"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"type": "string"},
        "status": {"type": "string"},
        "message": {"type": "string"},
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "human_review_required": {"type": "boolean"},
        "not_claimed": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
