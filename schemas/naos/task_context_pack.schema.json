{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:task_context_pack:v1",
  "title": "NAOS Task Context Pack Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "task_id",
    "task_card",
    "task_registry",
    "compact",
    "source_of_truth_hierarchy",
    "authoritative_context",
    "relevant_specs",
    "relevant_capabilities",
    "policy_profile",
    "existing_code_context",
    "function_index_context",
    "module_header_context",
    "spec_cascade_context",
    "implementation_readiness_context",
    "test_evidence_context",
    "systemic_impact_context",
    "control_plane_review_context",
    "setup_recommendations_context",
    "memory_context",
    "evidence_attestation_context",
    "local_context_index_context",
    "local_context_query_context",
    "semantic_candidate_layer_context",
    "graph_context_readiness_context",
    "graph_context_query_context",
    "session_lifecycle_context",
    "gates_context",
    "known_gaps",
    "residual_risks",
    "waivers",
    "commands_to_run",
    "human_review_boundary",
    "source_artifacts",
    "source_artifacts_used",
    "source_artifacts_missing",
    "source_artifact_freshness",
    "findings",
    "limitations",
    "not_claimed",
    "summary"
  ],
  "properties": {
    "context_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "manifest_sha256",
        "status",
        "evidence_dimensions"
      ],
      "properties": {
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "project_id",
            "task_id",
            "session_id",
            "profile",
            "naos_root",
            "association_at_freeze",
            "scope",
            "inputs",
            "rules",
            "exclusions",
            "supersedes_pack_sha256",
            "representation"
          ],
          "properties": {
            "schema": {
              "const": "naos.task_context_selection.v1"
            },
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "task_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 8
            },
            "profile": {
              "type": "string"
            },
            "naos_root": {
              "type": "string"
            },
            "association_at_freeze": {
              "enum": [
                "matched",
                "scope_mismatch",
                "unsafe",
                "unknown"
              ]
            },
            "scope": {
              "const": "explicit_paths_only"
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "state",
                  "sha256",
                  "size_bytes",
                  "expected_output"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "present",
                      "missing",
                      "unsafe",
                      "unreadable",
                      "oversized",
                      "partial"
                    ]
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "size_bytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "expected_output": {
                    "type": "boolean"
                  }
                }
              }
            },
            "rules": {
              "type": "object",
              "required": [
                "path",
                "state",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "enum": [
                    "present",
                    "missing",
                    "unsafe",
                    "unreadable",
                    "oversized",
                    "partial"
                  ]
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "supersedes_pack_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "representation": {
              "const": "raw_file_bytes_no_newline_or_case_folding"
            }
          }
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "matched",
            "changed",
            "expected_changed",
            "missing",
            "unsafe",
            "unreadable",
            "oversized",
            "partial",
            "scope_mismatch",
            "superseded",
            "unknown"
          ]
        },
        "evidence_dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "observable",
            "host_delivery",
            "model_use",
            "behavioral_effectiveness"
          ],
          "properties": {
            "issuer": {
              "const": "local_deterministic_cli"
            },
            "observable": {
              "const": "selected_bytes_at_check_time"
            },
            "host_delivery": {
              "const": "not_observed"
            },
            "model_use": {
              "const": "unknown"
            },
            "behavioral_effectiveness": {
              "const": "not_evaluated"
            }
          }
        }
      }
    },
    "schema": {"type": "string"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string"},
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "advisory",
        "review_required",
        "missing_task",
        "task_not_found",
        "unsupported_legacy_status",
        "missing_task_card",
        "missing_registry",
        "missing_required_source",
        "stale_source",
        "not_configured",
        "disabled",
        "blocked",
        "unknown"
      ]
    },
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "task_id": {"type": "string"},
    "task_card": {"type": "object"},
    "task_resolution": {"type": "object"},
    "task_record_kind": {"type": ["string", "null"]},
    "lifecycle_state": {"type": ["string", "null"]},
    "delivery_state": {"type": ["string", "null"]},
    "verification_state": {"type": ["string", "null"]},
    "task_registry": {"type": "object"},
    "parallel_lane_context": {"type": "object"},
    "compact": {"type": "object"},
    "source_of_truth_hierarchy": {"type": "array", "items": {"type": "object"}},
    "authoritative_context": {"type": "object"},
    "relevant_specs": {"type": "array", "items": {"type": "object"}},
    "relevant_capabilities": {"type": "array", "items": {"type": "object"}},
    "policy_profile": {"type": "object"},
    "existing_code_context": {"type": "object"},
    "function_index_context": {"type": "object"},
    "module_header_context": {"type": "object"},
    "spec_cascade_context": {"type": "object"},
    "implementation_readiness_context": {"type": "object"},
    "test_evidence_context": {"type": "object"},
    "systemic_impact_context": {"type": "object"},
    "control_plane_review_context": {"type": "object"},
    "setup_recommendations_context": {"type": "object"},
    "memory_context": {"type": "object"},
    "evidence_attestation_context": {"type": "object"},
    "local_context_index_context": {"type": "object", "properties": {"collection_coverage": {"anyOf": [{"type": "object", "required": ["schema", "status", "max_artifacts", "indexed_artifacts", "capacity_deferred_paths", "other_exclusion_records", "scope", "limitations"], "properties": {"schema": {"const": "naos.local_context_collection_coverage.v1"}, "status": {"enum": ["complete_within_configured_bounds", "incomplete_capacity"]}, "max_artifacts": {"type": "integer", "minimum": 1}, "indexed_artifacts": {"type": "integer", "minimum": 0}, "capacity_deferred_paths": {"type": "integer", "minimum": 0}, "other_exclusion_records": {"type": "integer", "minimum": 0}, "scope": {"const": "configured artifact collection; capacity accounting only"}, "limitations": {"const": ["Capacity-deferred paths were not read or checked for secret-like content.", "Other exclusion records include policy, size, privacy and unsafe-topology exclusions; they are not all intentional omissions.", "Counts do not measure all discovered, eligible or content-read files, complete repository coverage, or retrieval relevance."]}}, "additionalProperties": false}, {"type": "null"}]}}},
    "local_context_query_context": {"type": "object", "properties": {"collection_coverage": {"anyOf": [{"type": "object", "required": ["schema", "status", "max_artifacts", "indexed_artifacts", "capacity_deferred_paths", "other_exclusion_records", "scope", "limitations"], "properties": {"schema": {"const": "naos.local_context_collection_coverage.v1"}, "status": {"enum": ["complete_within_configured_bounds", "incomplete_capacity"]}, "max_artifacts": {"type": "integer", "minimum": 1}, "indexed_artifacts": {"type": "integer", "minimum": 0}, "capacity_deferred_paths": {"type": "integer", "minimum": 0}, "other_exclusion_records": {"type": "integer", "minimum": 0}, "scope": {"const": "configured artifact collection; capacity accounting only"}, "limitations": {"const": ["Capacity-deferred paths were not read or checked for secret-like content.", "Other exclusion records include policy, size, privacy and unsafe-topology exclusions; they are not all intentional omissions.", "Counts do not measure all discovered, eligible or content-read files, complete repository coverage, or retrieval relevance."]}}, "additionalProperties": false}, {"type": "null"}]}}},
    "semantic_candidate_layer_context": {"type": "object"},
    "graph_context_readiness_context": {"type": "object"},
    "graph_context_query_context": {"type": "object"},
    "session_lifecycle_context": {"type": "object"},
    "gates_context": {"type": "object"},
    "known_gaps": {"type": "array"},
    "residual_risks": {"type": "array"},
    "waivers": {"type": "array"},
    "commands_to_run": {"type": "array", "items": {"type": "string"}},
    "human_review_boundary": {"type": "object"},
    "source_artifacts": {"type": "array", "items": {"type": "object"}},
    "source_artifacts_used": {"type": "array", "items": {"type": "string"}},
    "source_artifacts_missing": {"type": "array", "items": {"type": "string"}},
    "source_artifact_freshness": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "object"}
  }
}
