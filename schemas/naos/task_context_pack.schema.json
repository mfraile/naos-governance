{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:task_context_pack:v1",
  "title": "NAOS Task Context Pack Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "task_id",
    "task_card",
    "task_registry",
    "compact",
    "source_of_truth_hierarchy",
    "authoritative_context",
    "relevant_specs",
    "relevant_capabilities",
    "policy_profile",
    "existing_code_context",
    "function_index_context",
    "module_header_context",
    "spec_cascade_context",
    "implementation_readiness_context",
    "test_evidence_context",
    "systemic_impact_context",
    "control_plane_review_context",
    "setup_recommendations_context",
    "memory_context",
    "evidence_attestation_context",
    "local_context_index_context",
    "local_context_query_context",
    "semantic_candidate_layer_context",
    "graph_context_readiness_context",
    "graph_context_query_context",
    "session_lifecycle_context",
    "gates_context",
    "known_gaps",
    "residual_risks",
    "waivers",
    "commands_to_run",
    "human_review_boundary",
    "source_artifacts",
    "source_artifacts_used",
    "source_artifacts_missing",
    "source_artifact_freshness",
    "findings",
    "limitations",
    "not_claimed",
    "summary"
  ],
  "properties": {
    "schema": {"type": "string"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string"},
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "advisory",
        "review_required",
        "missing_task",
        "task_not_found",
        "unsupported_legacy_status",
        "missing_task_card",
        "missing_registry",
        "missing_required_source",
        "stale_source",
        "not_configured",
        "disabled",
        "blocked",
        "unknown"
      ]
    },
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "task_id": {"type": "string"},
    "task_card": {"type": "object"},
    "task_resolution": {"type": "object"},
    "task_record_kind": {"type": ["string", "null"]},
    "lifecycle_state": {"type": ["string", "null"]},
    "delivery_state": {"type": ["string", "null"]},
    "verification_state": {"type": ["string", "null"]},
    "task_registry": {"type": "object"},
    "parallel_lane_context": {"type": "object"},
    "compact": {"type": "object"},
    "source_of_truth_hierarchy": {"type": "array", "items": {"type": "object"}},
    "authoritative_context": {"type": "object"},
    "relevant_specs": {"type": "array", "items": {"type": "object"}},
    "relevant_capabilities": {"type": "array", "items": {"type": "object"}},
    "policy_profile": {"type": "object"},
    "existing_code_context": {"type": "object"},
    "function_index_context": {"type": "object"},
    "module_header_context": {"type": "object"},
    "spec_cascade_context": {"type": "object"},
    "implementation_readiness_context": {"type": "object"},
    "test_evidence_context": {"type": "object"},
    "systemic_impact_context": {"type": "object"},
    "control_plane_review_context": {"type": "object"},
    "setup_recommendations_context": {"type": "object"},
    "memory_context": {"type": "object"},
    "evidence_attestation_context": {"type": "object"},
    "local_context_index_context": {"type": "object"},
    "local_context_query_context": {"type": "object"},
    "semantic_candidate_layer_context": {"type": "object"},
    "graph_context_readiness_context": {"type": "object"},
    "graph_context_query_context": {"type": "object"},
    "session_lifecycle_context": {"type": "object"},
    "gates_context": {"type": "object"},
    "known_gaps": {"type": "array"},
    "residual_risks": {"type": "array"},
    "waivers": {"type": "array"},
    "commands_to_run": {"type": "array", "items": {"type": "string"}},
    "human_review_boundary": {"type": "object"},
    "source_artifacts": {"type": "array", "items": {"type": "object"}},
    "source_artifacts_used": {"type": "array", "items": {"type": "string"}},
    "source_artifacts_missing": {"type": "array", "items": {"type": "string"}},
    "source_artifact_freshness": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "object"}
  }
}
