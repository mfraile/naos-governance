{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:install_decision_record:v1",
  "title": "NAOS Install Decision Record Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "command",
    "mode",
    "naos_root",
    "project_root",
    "human_review_required",
    "not_claimed",
    "limitations",
    "findings",
    "summary",
    "adoption_mode",
    "selected_profile",
    "command_invocation",
    "project_path",
    "preflight_summary",
    "intake_answers_summary",
    "discovered_facts",
    "assumptions",
    "inferred_candidates",
    "missing_information",
    "existing_resource_inventory_summary",
    "ai_artifact_inventory_summary",
    "memory_mcp_inventory_summary",
    "reconciliation_decisions",
    "files_created",
    "files_skipped",
    "files_preserved",
    "protected_files",
    "collisions",
    "challenge_reports",
    "gate_readiness_baseline_summary",
    "candidate_fr_nfr_summary",
    "traceability_gap_summary",
    "residual_risks",
    "user_decisions",
    "next_actions",
    "human_review_boundary",
    "non_claims"
  ],
  "properties": {
    "schema": {"const": "naos.install_decision_record.v1"},
    "generated_at": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"enum": ["ready", "advisory", "review_required", "warning", "invalid_config", "blocked", "unknown"]},
    "command": {"const": "install-decision-record"},
    "mode": {"type": "string"},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "session_id": {"type": ["string", "null"]},
    "generated_by": {"type": "object"},
    "human_review_required": {"type": "boolean"},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array"},
    "residual_risks": {"type": "array"},
    "summary": {"type": "object"},
    "adoption_mode": {"enum": ["greenfield", "brownfield", "upgrade", "repair", "evaluation"]},
    "selected_profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "command_invocation": {"type": "object"},
    "project_path": {"type": "string"},
    "preflight_summary": {"type": "object"},
    "intake_answers_summary": {"type": "object"},
    "discovered_facts": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array"},
    "inferred_candidates": {"type": "array", "items": {"type": "object"}},
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "existing_resource_inventory_summary": {"type": "object"},
    "ai_artifact_inventory_summary": {"type": "object"},
    "memory_mcp_inventory_summary": {"type": "object"},
    "reconciliation_decisions": {"type": "object"},
    "files_created": {"type": "array", "items": {"type": "object"}},
    "files_refreshed": {"type": "array", "items": {"type": "object"}},
    "files_planned": {"type": "array", "items": {"type": "object"}},
    "file_write_inventory_scope": {"type": "string", "minLength": 1},
    "files_skipped": {"type": "array", "items": {"type": "object"}},
    "files_preserved": {"type": "array", "items": {"type": "object"}},
    "protected_files": {"type": "array", "items": {"type": "string"}},
    "collisions": {"type": "array", "items": {"type": "object"}},
    "challenge_reports": {"type": "array", "items": {"type": "object"}},
    "gate_readiness_baseline_summary": {"type": "object"},
    "candidate_fr_nfr_summary": {
      "type": "object",
      "required": ["total", "by_type", "by_confidence", "human_review_required", "non_claims"],
      "additionalProperties": true
    },
    "traceability_gap_summary": {"type": "object"},
    "repository_intelligence": {"type": ["object", "null"]},
    "user_decisions": {"type": "array", "items": {"type": "object"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "human_review_boundary": {"type": "string"},
    "non_claims": {"type": "array", "items": {"type": "string"}},
    "report_refs": {"type": "array", "items": {"type": "object"}}
  }
}
