{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:local_context_query:v1",
  "title": "NAOS Local Context Query Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "query",
    "query_mode_requested",
    "query_mode_used",
    "source_index",
    "sqlite_artifact",
    "fts_available",
    "fts_query_sanitization",
    "filters",
    "results",
    "result_count",
    "bounded_result_limit",
    "source_artifacts",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.local_context_query.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ready", "advisory", "not_configured", "blocked", "unknown"]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "query": { "type": "object" },
    "query_mode_requested": { "type": "array" },
    "query_mode_used": { "type": "array" },
    "source_index": { "type": "object" },
    "sqlite_artifact": { "type": "object" },
    "fts_available": { "type": "boolean" },
    "fts_query_sanitization": { "type": "object" },
    "filters": { "type": "object" },
    "results": { "type": "array" },
    "result_count": { "type": "integer", "minimum": 0 },
    "bounded_result_limit": { "type": "integer", "minimum": 1 },
    "source_artifacts": { "type": "array" },
    "findings": { "type": "array" },
    "known_gaps": { "type": "array" },
    "residual_risks": { "type": "array" },
    "limitations": { "type": "array" },
    "not_claimed": { "type": "array" },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
