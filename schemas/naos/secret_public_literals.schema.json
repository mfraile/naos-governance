{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:secret_public_literals:v1",
  "title": "NAOS shipped public literal declaration",
  "description": "Digest-bound exact entropy-only public declarations. No credential, ownership or authorization assurance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "groups"],
  "properties": {
    "schema": {"const": "naos.secret_public_literals.v1"},
    "groups": {
      "type": "array", "minItems": 1, "maxItems": 2048,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "source", "selector", "component_sha256", "values"],
        "properties": {
          "kind": {"enum": ["literal", "project_path", "kit_path"]},
          "source": {"type": "string", "minLength": 1},
          "selector": {"type": "string", "minLength": 1, "maxLength": 256},
          "component_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "values": {"type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
        }
      }
    }
  }
}
