{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:session_lifecycle:v1",
  "title": "NAOS Session Lifecycle Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "mode",
    "naos_root",
    "project_root",
    "rules_path",
    "rules_hash",
    "task_id",
    "task_discovery",
    "task_registry",
    "active_task_card",
    "compact",
    "git_state",
    "report_inputs",
    "freshness_summary",
    "context_posture",
    "memory_posture",
    "memory_candidate_proposals",
    "recommended_commands",
    "routing_recommendations",
    "known_gaps",
    "residual_risks",
    "waivers",
    "findings",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.session_lifecycle.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "advisory",
        "review_required",
        "missing_task",
        "task_not_found",
        "unsupported_legacy_status",
        "missing_task_card",
        "missing_registry",
        "stale_context",
        "checkpoint_gap",
        "end_review_required",
        "disabled",
        "not_configured",
        "blocked",
        "unknown"
      ]
    },
    "mode": {"type": "string", "enum": ["session_start", "session_checkpoint", "session_end"]},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "rules_path": {"type": "string"},
    "rules_hash": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "task_discovery": {"type": "object"},
    "task_resolution": {"type": "object"},
    "task_record": {"type": "object"},
    "lifecycle_state": {"type": ["string", "null"]},
    "delivery_state": {"type": ["string", "null"]},
    "verification_state": {"type": ["string", "null"]},
    "task_registry": {"type": "object"},
    "active_task_card": {"type": "object"},
    "compact": {"type": "object"},
    "git_state": {"type": "object"},
    "report_inputs": {"type": "object"},
    "freshness_summary": {"type": "object"},
    "context_posture": {"type": "object"},
    "memory_posture": {"type": "object"},
    "memory_candidate_proposals": {
      "type": "array",
      "items": {"$ref": "#/$defs/memory_candidate_proposal"}
    },
    "recommended_commands": {"type": "array", "items": {"type": "string"}},
    "routing_recommendations": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array"},
    "residual_risks": {"type": "array"},
    "waivers": {"type": "array"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "status", "message"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"type": "string", "enum": ["none", "advisory", "warning", "required", "blocking"]},
        "status": {"type": "string"},
        "message": {"type": "string"},
        "required_next_actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "memory_candidate_proposal": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "proposal_id",
        "task_id",
        "source_reference",
        "candidate_summary",
        "proposed_state",
        "allowed_use",
        "requires_human_review",
        "proposal_only",
        "not_written",
        "limitations"
      ],
      "properties": {
        "proposal_id": {"type": "string"},
        "task_id": {"type": ["string", "null"]},
        "source_reference": {"type": "object"},
        "candidate_summary": {"type": "string"},
        "proposed_state": {"type": "string"},
        "allowed_use": {"type": "string"},
        "requires_human_review": {"type": "boolean"},
        "proposal_only": {"const": true},
        "not_written": {"const": true},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
