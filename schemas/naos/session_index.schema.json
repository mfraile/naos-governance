{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:session_index:v1",
  "title": "NAOS Session Index",
  "description": "Index of generated NAOS session records. It supports session report namespacing and local operator attribution signals, but is not a locking mechanism, audit log, approval record, authentication system, authorization system, or separation-of-duties control.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "sessions",
    "active_session_ids",
    "closed_session_ids",
    "latest_session_id",
    "limitations",
    "not_claimed",
    "human_review_required"
  ],
  "properties": {
    "schema": {"type": "string", "const": "naos.session_index.v1"},
    "generated_at": {"type": "string"},
    "sessions": {
      "type": "array",
      "items": {"$ref": "#/$defs/session_record"}
    },
    "active_session_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/session_id"}
    },
    "closed_session_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/session_id"}
    },
    "latest_session_id": {"anyOf": [{"$ref": "#/$defs/session_id"}, {"type": "null"}]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"}
  },
  "$defs": {
    "session_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*(?![\\s\\S])"
    },
    "session_record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "session_id",
        "created_at",
        "updated_at",
        "status",
        "profile",
        "report_root",
        "latest_reports",
        "operator_id",
        "limitations",
        "not_claimed"
      ],
      "properties": {
        "session_id": {"$ref": "#/$defs/session_id"},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"},
        "status": {"type": "string", "enum": ["active", "closed", "unknown"]},
        "task_id": {"type": ["string", "null"]},
        "profile": {"type": "string"},
        "report_root": {"type": "string"},
        "latest_reports": {"type": "object"},
        "operator_id": {"type": ["string", "null"]},
        "operator_source": {"type": ["string", "null"], "enum": ["env", "git_email", "git_name", "os_user", "unknown", null]},
        "operator_attribution_status": {"type": ["string", "null"], "enum": ["resolved", "unknown", "conflicting", "not_configured", null]},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "not_claimed": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
