{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:api_symbol_reality:v1",
  "title": "NAOS API Symbol Reality Report",
  "description": "Bounded API-symbol reality report for explicitly declared Python symbols. Findings are review evidence only and are not semantic correctness, runtime behavior, package safety, approval, certification, compliance, or hallucination-prevention proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "configured",
    "project_root",
    "naos_root",
    "manifest_path",
    "manifest_present",
    "deterministic",
    "imports_executed",
    "network_used",
    "cost_posture",
    "summary",
    "symbols",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required"
  ],
  "properties": {
    "schema": {"const": "naos.api_symbol_reality.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"type": "string", "enum": ["pass", "advisory", "warning", "required_missing", "blocked"]},
    "configured": {"type": "boolean"},
    "project_root": {"type": "string"},
    "naos_root": {"type": "string"},
    "manifest_path": {"type": "string"},
    "manifest_present": {"type": "boolean"},
    "deterministic": {"type": "boolean"},
    "imports_executed": {"type": "boolean"},
    "network_used": {"type": "boolean"},
    "cost_posture": {"$ref": "#/$defs/cost_posture"},
    "summary": {"type": "object", "additionalProperties": true},
    "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol_result"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"}
  },
  "$defs": {
    "cost_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_incurred_by_default",
        "cost_usd",
        "external_api_required",
        "provider_dependency_required",
        "model_dependency_required",
        "human_approval_required_before_cost"
      ],
      "properties": {
        "cost_incurred_by_default": {"type": "boolean"},
        "cost_usd": {"type": "number", "minimum": 0},
        "external_api_required": {"type": "boolean"},
        "provider_dependency_required": {"type": "boolean"},
        "model_dependency_required": {"type": "boolean"},
        "human_approval_required_before_cost": {"type": "boolean"}
      }
    },
    "symbol_result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "module", "symbol", "status", "import_executed"],
      "properties": {
        "id": {"type": "string"},
        "package": {"type": ["string", "null"]},
        "module": {"type": "string"},
        "symbol": {"type": "string"},
        "status": {"type": "string", "enum": ["verified", "unverified", "invalid"]},
        "source_type": {"type": ["string", "null"]},
        "source_path": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "import_executed": {"type": "boolean"},
        "inspection": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "status", "message", "human_review_required", "not_claimed"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"type": "string"},
        "status": {"type": "string"},
        "message": {"type": "string"},
        "entry_id": {"type": "string"},
        "package": {"type": ["string", "null"]},
        "module": {"type": "string"},
        "symbol": {"type": "string"},
        "source_type": {"type": "string"},
        "source_path": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "human_review_required": {"type": "boolean"},
        "not_claimed": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
