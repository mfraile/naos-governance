{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:ai_artifact_inventory:v1",
  "title": "NAOS AI Artifact Inventory Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "command",
    "mode",
    "naos_root",
    "project_root",
    "human_review_required",
    "not_claimed",
    "limitations",
    "findings",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "naos.ai_artifact_inventory.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "quickstart",
        "lite",
        "standard",
        "assured"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "advisory",
        "review_required",
        "warning",
        "invalid_config",
        "blocked",
        "unknown"
      ]
    },
    "command": {
      "const": "ai-artifact-inventory"
    },
    "mode": {
      "type": "string"
    },
    "naos_root": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_by": {
      "type": "object"
    },
    "human_review_required": {
      "type": "boolean"
    },
    "not_claimed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "known_gaps": {
      "type": "array"
    },
    "residual_risks": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "artifact_id",
          "artifact_type",
          "path",
          "classification",
          "classifications",
          "detected_owner",
          "detected_source",
          "status",
          "conflict_category",
          "conflict_reason",
          "compared_surface",
          "profile_impact",
          "recommended_decision",
          "decision_state",
          "human_review_required",
          "human_review_boundary",
          "non_claims"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "NAOS-owned",
              "user-owned",
              "third-party",
              "unknown"
            ]
          },
          "classifications": {
            "type": "array",
            "items": {
              "enum": [
                "NAOS-owned",
                "user-owned",
                "third-party",
                "compatible",
                "conflicting",
                "stale",
                "unknown",
                "review_required"
              ]
            }
          },
          "detected_owner": {
            "enum": [
              "NAOS-owned",
              "user-owned",
              "third-party",
              "unknown"
            ]
          },
          "detected_source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "compatible",
              "conflicting",
              "stale",
              "unknown",
              "review_required"
            ]
          },
          "conflict_category": {
            "type": "string"
          },
          "conflict_reason": {
            "type": "string"
          },
          "compared_surface": {
            "type": "string"
          },
          "profile_impact": {
            "type": "string"
          },
          "recommended_decision": {
            "enum": [
              "keep",
              "merge",
              "replace",
              "quarantine",
              "create",
              "review_required"
            ]
          },
          "decision_state": {
            "enum": [
              "keep",
              "merge",
              "replace",
              "quarantine",
              "create",
              "review_required"
            ]
          },
          "human_review_required": {
            "type": "boolean"
          },
          "human_review_boundary": {
            "type": "string"
          },
          "non_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deprecation_evidence": {
            "type": "object",
            "required": [
              "verified",
              "marker_mentions",
              "sample_character_limit",
              "interpretation"
            ],
            "properties": {
              "verified": {
                "const": false
              },
              "marker_mentions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "marker",
                    "locations"
                  ],
                  "properties": {
                    "marker": {
                      "enum": [
                        "stale",
                        "deprecated",
                        "legacy",
                        "archive",
                        "old instructions"
                      ]
                    },
                    "locations": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "path",
                          "content"
                        ]
                      }
                    }
                  }
                }
              },
              "sample_character_limit": {
                "enum": [0, 12000]
              },
              "interpretation": {
                "const": "keyword_context_does_not_establish_artifact_deprecation"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "deprecation_evidence"
              ],
              "properties": {
                "deprecation_evidence": {
                  "required": [
                    "sample_character_limit"
                  ],
                  "properties": {
                    "sample_character_limit": {
                      "const": 0
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "content_handling"
              ],
              "properties": {
                "content_handling": {
                  "const": "raw_hash_only_sensitive_configuration"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "path",
                    "artifact_type",
                    "detected_source"
                  ],
                  "properties": {
                    "path": {
                      "const": ".cursor/mcp.json"
                    },
                    "detected_source": {
                      "const": "cursor_mcp_configuration"
                    },
                    "artifact_type": {
                      "const": "cursor_mcp_configuration"
                    }
                  }
                },
                {
                  "required": [
                    "path",
                    "artifact_type",
                    "detected_source"
                  ],
                  "properties": {
                    "path": {
                      "const": ".vscode/mcp.json"
                    },
                    "detected_source": {
                      "const": "vscode_mcp_configuration"
                    },
                    "artifact_type": {
                      "const": "vscode_mcp_configuration"
                    }
                  }
                },
                {
                  "required": [
                    "path",
                    "artifact_type",
                    "detected_source"
                  ],
                  "properties": {
                    "path": {
                      "const": ".mcp.json"
                    },
                    "detected_source": {
                      "const": "workspace_mcp_configuration"
                    },
                    "artifact_type": {
                      "const": "workspace_mcp_configuration"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "artifact_counts": {
      "type": "object"
    },
    "classification_counts": {
      "type": "object"
    },
    "status_counts": {
      "type": "object"
    },
    "conflict_counts": {
      "type": "object"
    },
    "scan_scope": {
      "type": "object",
      "required": [
        "effective_patterns",
        "limits",
        "issues",
        "truncated",
        "complete",
        "invalid_config"
      ],
      "properties": {
        "rules_source": {
          "enum": [
            "defaults",
            "project"
          ]
        },
        "rules_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "invalid_config": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
