{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:repository_intelligence_plan:v1",
  "title": "NAOS Repository Intelligence Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "status", "plan_id", "plan_sha256", "control", "bundle", "findings", "effectiveness_hypothesis", "limitations", "not_claimed", "human_review_required"],
  "properties": {
    "schema": {"const": "naos.repository_intelligence.plan.v1"},
    "created_at": {"type": "string"},
    "status": {"enum": ["confirmation_required", "enrollment_required", "not_applicable", "blocked_prerequisite"]},
    "plan_id": {"type": "string", "pattern": "^RI-[0-9a-f]{16}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "plan_file": {"type": "string"},
    "control": {
      "type": "object",
      "required": ["capability_id", "project_root", "profile", "purpose", "component_mode", "relationship_questions", "naos_root", "effective_source_sha256", "source_inventory", "rules", "runtime", "implementation", "provenance_gate", "maturity", "components", "graph_model_sha256", "generation_id", "generation_content_sha256", "bundle_sha256", "coverage", "ongoing_use_scope", "profile_gate", "apply_allowed", "generation_layout", "invalidated_by", "not_claimed"],
      "properties": {
        "capability_id": {"const": "CAP-LOCAL-CONTEXT-INDEX"},
        "project_root": {"type": "string"},
        "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
        "purpose": {"enum": ["brownfield-onboarding", "ongoing-change-impact", "task-context"]},
        "component_mode": {"enum": ["auto", "baseline", "graph"]},
        "relationship_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "naos_root": {"type": "string", "minLength": 1},
        "effective_source_sha256": {"$ref": "#/$defs/sha256"},
        "source_inventory": {"type": "array"},
        "rules": {"type": "object"},
        "runtime": {"type": "object"},
        "implementation": {"type": "object"},
        "refresh_base": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/refresh_base"}]},
        "provenance_gate": {"type": "object"},
        "maturity": {"type": "object"},
        "components": {"type": "object"},
        "graph_model_sha256": {"$ref": "#/$defs/sha256"},
        "generation_id": {"type": ["string", "null"], "pattern": "^RI-[0-9a-f]{24}$"},
        "generation_content_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "bundle_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "coverage": {"type": "object"},
        "ongoing_use_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "profile_gate": {"type": "object"},
        "apply_allowed": {"type": "boolean"},
        "generation_layout": {"type": "object"},
        "invalidated_by": {"type": "array", "items": {"type": "string"}},
        "not_claimed": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "bundle": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema", "path", "generation_id", "generation_content_sha256", "files", "validation", "generated_state_only", "bundle_sha256"],
      "properties": {
        "schema": {"const": "naos.repository_intelligence.plan_bundle.v1"},
        "path": {"type": "string", "minLength": 1},
        "generation_id": {"type": "string", "pattern": "^RI-[0-9a-f]{24}$"},
        "generation_content_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/file_record"}
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sqlite_fts", "networkx_graphml", "source_revalidated", "exact_bytes_ready_for_activation", "provenance_valid"],
          "properties": {
            "status": {"enum": ["validated", "diagnostic_only"]},
            "sqlite_fts": {"type": "object"},
            "networkx_graphml": {"type": "object"},
            "source_revalidated": {"const": true},
            "exact_bytes_ready_for_activation": {"type": "boolean"},
            "provenance_valid": {"type": "boolean"}
          }
        },
        "generated_state_only": {"const": true},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "effectiveness_hypothesis": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"bundle": {"type": "null"}}},
      "then": {
        "properties": {
          "status": {"enum": ["not_applicable", "blocked_prerequisite"]},
          "control": {"properties": {
            "apply_allowed": {"const": false},
            "generation_id": {"type": "null"},
            "generation_content_sha256": {"type": "null"},
            "bundle_sha256": {"type": "null"}
          }}
        }
      },
      "else": {"properties": {"control": {"properties": {
        "generation_id": {"type": "string"},
        "generation_content_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }}}}
    }
  ],
  "$defs": {
    "posix_native_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stat_fields_decimal",
        "metadata"
      ],
      "properties": {
        "stat_fields_decimal": {
          "type": "array",
          "minItems": 5,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "windows_storage_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "volume_serial_hex",
        "file_id_hex",
        "kind",
        "security_sha256"
      ],
      "properties": {
        "schema": {
          "const": "naos.repository_intelligence.windows_object_identity.v1"
        },
        "volume_serial_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "file_id_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "security_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windows_native_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "handle_info"
      ],
      "properties": {
        "storage": {
          "$ref": "#/$defs/windows_storage_identity"
        },
        "handle_info": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "volume",
            "links",
            "size",
            "attributes",
            "reparse_tag",
            "created_time",
            "modified_time",
            "changed_time",
            "file_id",
            "directory"
          ],
          "properties": {
            "volume": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "links": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "size": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "attributes": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "reparse_tag": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "created_time": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "modified_time": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "changed_time": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "file_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "directory": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "refresh_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "backend",
        "generation_id",
        "operation_id",
        "pointer",
        "manifest_file_sha256",
        "manifest_sha256",
        "bindings",
        "files",
        "directories",
        "memberships"
      ],
      "properties": {
        "schema": {
          "const": "naos.repository_intelligence.refresh_base.v1"
        },
        "backend": {
          "enum": [
            "posix",
            "windows"
          ]
        },
        "generation_id": {
          "type": "string",
          "pattern": "^RI-[0-9a-f]{24}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^(RIT-[0-9a-f]{24}|WOP-[0-9a-f]{16})$"
        },
        "pointer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "native_identity"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "native_identity": {
              "oneOf": [
                {
                  "$ref": "#/$defs/posix_native_witness"
                },
                {
                  "$ref": "#/$defs/windows_native_witness"
                }
              ]
            }
          }
        },
        "manifest_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "runtime",
            "components",
            "provenance_gate",
            "generation_content_sha256",
            "effective_source_sha256",
            "graph_model_sha256",
            "rules_sha256",
            "contract_schema_sha256"
          ],
          "properties": {
            "implementation": {
              "type": "object"
            },
            "runtime": {
              "type": "object"
            },
            "components": {
              "type": "object"
            },
            "provenance_gate": {
              "type": "object"
            },
            "generation_content_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "effective_source_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "graph_model_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "rules_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "contract_schema_sha256": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository_intelligence_activation_receipt.schema.json",
                "repository_intelligence_active.schema.json",
                "repository_intelligence_apply_result.schema.json",
                "repository_intelligence_apply_result_v2.schema.json",
                "repository_intelligence_context.schema.json",
                "repository_intelligence_context_v2.schema.json",
                "repository_intelligence_enrollment_result.schema.json",
                "repository_intelligence_enrollment_result_v2.schema.json",
                "repository_intelligence_inventory.schema.json",
                "repository_intelligence_manifest.schema.json",
                "repository_intelligence_plan.schema.json",
                "repository_intelligence_query.schema.json",
                "repository_intelligence_recovery_result.schema.json",
                "repository_intelligence_rules.schema.json",
                "repository_intelligence_status.schema.json",
                "repository_intelligence_transaction_journal.schema.json",
                "repository_intelligence_validation.schema.json",
                "repository_intelligence_windows_authorization.schema.json"
              ],
              "properties": {
                "repository_intelligence_activation_receipt.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_active.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_apply_result.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_apply_result_v2.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_context.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_context_v2.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_enrollment_result.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_enrollment_result_v2.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_inventory.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_manifest.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_plan.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_query.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_recovery_result.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_rules.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_status.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_transaction_journal.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_validation.schema.json": {
                  "$ref": "#/$defs/sha256"
                },
                "repository_intelligence_windows_authorization.schema.json": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "native_identity"
            ],
            "properties": {
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "native_identity": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/posix_native_witness"
                  },
                  {
                    "$ref": "#/$defs/windows_native_witness"
                  }
                ]
              }
            }
          }
        },
        "directories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/posix_native_witness"
              },
              {
                "$ref": "#/$defs/windows_native_witness"
              }
            ]
          }
        },
        "memberships": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "posix"
              }
            }
          },
          "then": {
            "properties": {
              "pointer": {
                "properties": {
                  "native_identity": {
                    "$ref": "#/$defs/posix_native_witness"
                  }
                }
              },
              "files": {
                "additionalProperties": {
                  "properties": {
                    "native_identity": {
                      "$ref": "#/$defs/posix_native_witness"
                    }
                  }
                }
              },
              "directories": {
                "additionalProperties": {
                  "$ref": "#/$defs/posix_native_witness"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "windows"
              }
            }
          },
          "then": {
            "properties": {
              "pointer": {
                "properties": {
                  "native_identity": {
                    "$ref": "#/$defs/windows_native_witness"
                  }
                }
              },
              "files": {
                "additionalProperties": {
                  "properties": {
                    "native_identity": {
                      "$ref": "#/$defs/windows_native_witness"
                    }
                  }
                }
              },
              "directories": {
                "additionalProperties": {
                  "$ref": "#/$defs/windows_native_witness"
                }
              }
            }
          }
        }
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"enum": ["inventory.json", "repository_intelligence_rules.yaml", "local_context_index.sqlite", "context.graphml", "validation_receipt.json", "manifest.json"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
