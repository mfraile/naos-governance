{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:semantic_candidate_layer:v1",
  "title": "NAOS Semantic Candidate Layer Readiness Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "rules_path",
    "rules_hash",
    "semantic_runtime_enabled",
    "sqlite_vec_enabled",
    "embeddings_enabled",
    "extension_loading_allowed",
    "external_embedding_calls_allowed",
    "cloud_embedding_allowed",
    "local_provider_required",
    "provider_posture",
    "embedding_model_policy",
    "sqlite_vec_posture",
    "extension_loading_posture",
    "semantic_query_posture",
    "source_hash_invalidation_policy",
    "sensitive_content_policy",
    "memory_policy",
    "task_scoped_prefilter_policy",
    "global_scan_policy",
    "ranking_explanation_policy",
    "candidate_only_policy",
    "future_data_model",
    "integration_points",
    "findings",
    "known_gaps",
    "residual_risks",
    "waivers",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.semantic_candidate_layer.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["disabled", "readiness_only", "advisory", "review_required", "blocked", "not_configured", "unknown"]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "rules_path": { "type": "string" },
    "rules_hash": { "type": ["string", "null"] },
    "semantic_runtime_enabled": { "type": "boolean" },
    "sqlite_vec_enabled": { "type": "boolean" },
    "embeddings_enabled": { "type": "boolean" },
    "extension_loading_allowed": { "type": "boolean" },
    "external_embedding_calls_allowed": { "type": "boolean" },
    "cloud_embedding_allowed": { "type": "boolean" },
    "local_provider_required": { "type": "boolean" },
    "provider_posture": { "type": "object" },
    "embedding_model_policy": { "type": "object" },
    "sqlite_vec_posture": { "type": "object" },
    "extension_loading_posture": { "type": "object" },
    "semantic_query_posture": { "type": "object" },
    "source_hash_invalidation_policy": { "type": "object" },
    "sensitive_content_policy": { "type": "object" },
    "memory_policy": { "type": "object" },
    "task_scoped_prefilter_policy": { "type": "object" },
    "global_scan_policy": { "type": "object" },
    "ranking_explanation_policy": { "type": "object" },
    "candidate_only_policy": { "type": "object" },
    "future_data_model": { "type": "object" },
    "integration_points": { "type": "object" },
    "findings": { "type": "array" },
    "known_gaps": { "type": "array" },
    "residual_risks": { "type": "array" },
    "waivers": { "type": "array" },
    "limitations": { "type": "array" },
    "not_claimed": { "type": "array" },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
