{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:candidate_requirements:v1",
  "title": "NAOS Candidate Requirements Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "generated_at", "profile", "status", "command", "mode", "naos_root", "project_root", "human_review_required", "not_claimed", "limitations", "findings", "summary", "candidates", "confidence_classes", "promotion_rule"],
  "properties": {
    "schema": {"const": "naos.candidate_requirements.v1"},
    "generated_at": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"enum": ["ready", "advisory", "review_required", "warning", "invalid_config", "blocked", "unknown"]},
    "command": {"const": "requirements-reconstruct"},
    "mode": {"type": "string"},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "session_id": {"type": ["string", "null"]},
    "generated_by": {"type": "object"},
    "human_review_required": {"type": "boolean"},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array"},
    "residual_risks": {"type": "array"},
    "summary": {"type": "object"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["candidate_id", "candidate_type", "title", "rationale", "evidence_refs", "confidence_class", "source_basis", "open_questions", "human_review_required", "non_claims"],
        "properties": {
          "candidate_id": {"type": "string"},
          "candidate_type": {"enum": ["FR", "NFR"]},
          "type": {"enum": ["functional", "non_functional"]},
          "title": {"type": "string"},
          "text": {"type": "string"},
          "rationale": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "confidence_class": {
            "enum": [
              "confirmed_by_existing_spec",
              "supported_by_docs",
              "inferred_from_code",
              "inferred_from_tests",
              "hypothesized_requires_review"
            ]
          },
          "source_basis": {"type": "string"},
          "open_questions": {"type": "array", "items": {"type": "string"}},
          "human_review_required": {"type": "boolean"},
          "non_claims": {"type": "array", "items": {"type": "string"}},
          "repository_intelligence_evidence": {
            "type": "array",
            "items": {"type": "object"}
          }
        }
      }
    },
    "candidate_counts": {"type": "object"},
    "candidate_type_counts": {"type": "object"},
    "confidence_classes": {"type": "array", "items": {"type": "string"}},
    "promotion_rule": {"const": "human_review_required"},
    "non_claims": {"type": "array", "items": {"type": "string"}},
    "reconstruction_coverage": {
      "type": "object",
      "required": [
        "scope",
        "discovery",
        "categories",
        "evidence_selection",
        "local_path_selection_complete",
        "requirements_complete",
        "content_read_completeness_verified",
        "repository_retrieval"
      ],
      "properties": {
        "scope": {
          "const": "bounded_local_path_selection_only"
        },
        "requirements_complete": {
          "const": false
        },
        "content_read_completeness_verified": {
          "const": false
        },
        "local_path_selection_complete": {
          "type": "boolean"
        },
        "discovery": {
          "type": "object",
          "required": [
            "file_count",
            "complete",
            "truncated",
            "issues",
            "max_files",
            "max_entries"
          ],
          "properties": {
            "file_count": {
              "type": "integer",
              "minimum": 0
            },
            "complete": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "max_files": {
              "type": "integer",
              "minimum": 0
            },
            "max_entries": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "categories": {
          "type": "object",
          "required": [
            "docs",
            "source",
            "tests",
            "workflows"
          ],
          "properties": {
            "docs": {
              "type": "object",
              "required": [
                "matched",
                "selected",
                "limit",
                "truncated"
              ],
              "properties": {
                "matched": {
                  "type": "integer",
                  "minimum": 0
                },
                "selected": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            },
            "source": {
              "type": "object",
              "required": [
                "matched",
                "selected",
                "limit",
                "truncated"
              ],
              "properties": {
                "matched": {
                  "type": "integer",
                  "minimum": 0
                },
                "selected": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            },
            "tests": {
              "type": "object",
              "required": [
                "matched",
                "selected",
                "limit",
                "truncated"
              ],
              "properties": {
                "matched": {
                  "type": "integer",
                  "minimum": 0
                },
                "selected": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            },
            "workflows": {
              "type": "object",
              "required": [
                "matched",
                "selected",
                "limit",
                "truncated"
              ],
              "properties": {
                "matched": {
                  "type": "integer",
                  "minimum": 0
                },
                "selected": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "evidence_selection": {
          "type": "object",
          "required": [
            "docs",
            "source",
            "tests_and_workflows"
          ],
          "properties": {
            "docs": {
              "type": "object",
              "required": [
                "available",
                "selected",
                "limit",
                "truncated"
              ],
              "properties": {
                "available": {
                  "type": "integer",
                  "minimum": 0
                },
                "selected": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            },
            "source": {
              "type": "object",
              "required": [
                "available",
                "selected",
                "limit",
                "truncated"
              ],
              "properties": {
                "available": {
                  "type": "integer",
                  "minimum": 0
                },
                "selected": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            },
            "tests_and_workflows": {
              "type": "object",
              "required": [
                "available",
                "selected",
                "limit",
                "truncated"
              ],
              "properties": {
                "available": {
                  "type": "integer",
                  "minimum": 0
                },
                "selected": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "repository_retrieval": {
          "type": "object",
          "required": [
            "input_records",
            "may_add_paths_outside_local_prefix",
            "completeness_claimed"
          ],
          "properties": {
            "input_records": {
              "type": "integer",
              "minimum": 0
            },
            "may_add_paths_outside_local_prefix": {
              "const": true
            },
            "completeness_claimed": {
              "const": false
            }
          }
        }
      }
    },
    "repository_intelligence": {"type": ["object", "null"]}
  }
}
