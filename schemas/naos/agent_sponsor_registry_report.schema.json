{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:agent-sponsor-registry-report:v1",
  "title": "NAOS Agent Sponsor Registry Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "generator_version",
    "profile",
    "status",
    "naos_root",
    "configured",
    "enabled",
    "format",
    "decision_supported",
    "verification_status",
    "registry",
    "provenance",
    "agents",
    "reason_code_counts",
    "report_digest",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.agent_sponsor_registry_report.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator_version": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"enum": ["pass", "review_required", "not_configured"]},
    "naos_root": {"type": "string"},
    "configured": {"type": "boolean"},
    "enabled": {"type": "boolean"},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"const": "agent_sponsor_registry.v1"},
        "version": {"const": 1},
        "kind": {"const": "build_time_declared_posture"}
      }
    },
    "decision_supported": {"type": "string"},
    "verification_status": {"const": "declared_not_verified"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source", "sha256", "schema_valid", "schema_error_count"],
      "properties": {
        "path": {"type": "string"},
        "source": {"type": "string"},
        "sha256": {"type": ["string", "null"]},
        "schema_valid": {"type": "boolean"},
        "schema_error_count": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "inputs", "input_set_digest"],
      "properties": {
        "basis": {"const": "repo_local_declared_posture"},
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "sha256"],
            "properties": {
              "path": {"type": "string"},
              "role": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "input_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "agent_name",
          "source_file",
          "source_sha256",
          "record_status",
          "sponsor_ref_sha256",
          "credential_posture",
          "review_expires_at"
        ],
        "properties": {
          "agent_id": {"type": "string"},
          "agent_name": {"type": "string"},
          "source_file": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "record_status": {"enum": ["current", "missing", "invalid", "expired", "review_required"]},
          "sponsor_ref_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "credential_posture": {"type": ["string", "null"]},
          "review_expires_at": {"type": ["string", "null"]}
        }
      }
    },
    "reason_code_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "report_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "reason_code", "message"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["advisory", "warning", "required", "blocking"]},
          "status": {"const": "review_required"},
          "reason_code": {"type": "string"},
          "message": {"type": "string"},
          "agent_id": {"type": "string"}
        }
      }
    },
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocking",
        "required",
        "warnings",
        "advisory",
        "total_findings",
        "agents",
        "records",
        "covered_agents",
        "expired_records",
        "credential_exceptions",
        "inputs"
      ],
      "properties": {
        "blocking": {"type": "integer", "minimum": 0},
        "required": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0},
        "total_findings": {"type": "integer", "minimum": 0},
        "agents": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 0},
        "covered_agents": {"type": "integer", "minimum": 0},
        "expired_records": {"type": "integer", "minimum": 0},
        "credential_exceptions": {"type": "integer", "minimum": 0},
        "inputs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
