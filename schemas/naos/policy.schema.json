        "systemic_impact_rules": {"type": "string"},
        "module_header_traceability_report": {"type": "string"},
        "spec_pack_contract_report": {"type": "string"},
        "spec_pack_materialization_report": {"type": "string"},
        "spec_assembly_worksheet_report": {"type": "string"},
        "spec_cascade_report": {"type": "string"},
        "module_header_rules": {"type": "string"},
        "control_plane_review_report": {"type": "string"},
        "control_plane_review_rules": {"type": "string"},
        "control_plane_review_items": {"type": "string"},
        "setup_recommendations_report": {"type": "string"},
        "setup_module_catalog": {"type": "string"},
        "governance_bypass_posture_report": {"type": "string"},
        "external_evidence_ingest_report": {"type": "string"},
        "evidence_attestation_report": {"type": "string"},
        "evidence_verification_report": {"type": "string"},
        "evidence_envelope_report": {"type": "string"},
        "evidence_conflict_detection_report": {"type": "string"},
        "evidence_attestation_rules": {"type": "string"},
        "evidence_review_attestations": {"type": "string"},
        "memory_context_readiness_report": {"type": "string"},
        "memory_context_rules": {"type": "string"},
        "memory_authorization_matrix": {"type": "string"},
        "memory_provider_access_report": {"type": "string"},
        "memory_provider_access_rules": {"type": "string"},
        "memory_use_policy_report": {"type": "string"},
        "memory_use_policy_rules": {"type": "string"},
        "memory_review_items": {"type": "string"},
        "learning_loop_review_report": {"type": "string"},
        "learning_loop_rules": {"type": "string"},
        "learning_candidates": {"type": "string"},
        "learning_state": {"type": "string"},
        "learning_history": {"type": "string"},
