        "behavioral_governance_readiness_rules": {"type": "string"},
        "behavioral_governance_readiness_baseline_state": {"type": "string"},
        "behavioral_governance_readiness_report": {"type": "string"},
        "sarif_report": {"type": "string"},
        "sarif_export_summary_report": {"type": "string"},
        "policy_override_merge_report": {"type": "string"},
        "pr_risk_classification_report": {"type": "string"},
        "plan_coherence_report": {"type": "string"},
        "pr_risk_rules": {"type": "string"},
        "pr_governance_summary_report": {"type": "string"},
        "agentic_workflow": {"type": "string"},
