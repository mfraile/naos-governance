        "audit_log_root": {"type": "string"},
        "audit_log_summary_report": {"type": "string"},
        "agent_trace_events": {"type": "string"},
        "agent_trace_validation_report": {"type": "string"},
        "ai_surface_context_budget_report": {"type": "string"},
