{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:policy:v1",
  "title": "NAOS File-First Policy",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "profiles", "paths", "claims", "evidence", "test_evidence"],
  "properties": {
    "version": {"type": "string"},
    "description": {"type": "string"},
    "task_claim_default_ttl_hours": {"type": "integer", "minimum": 1},
    "profiles": {
      "type": "object",
      "required": ["supported", "default", "severity_by_profile", "exit_code"],
      "properties": {
        "supported": {
          "type": "array",
          "items": {"type": "string"}
        },
        "default": {"type": "string"},
        "severity_by_profile": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["none", "advisory", "warning", "required", "blocking"]
          }
        },
        "exit_code": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["fail_on", "strict_fail_on"],
            "properties": {
              "fail_on": {
                "type": "array",
                "items": {"type": "string"}
              },
              "strict_fail_on": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "required": ["default_naos_root", "reports_dir", "ignored_scan_dirs"],
      "properties": {
        "default_naos_root": {"type": "string"},
        "reports_dir": {"type": "string"},
        "claims_report": {"type": "string"},
        "roadmap_report": {"type": "string"},
        "function_index_report": {"type": "string"},
