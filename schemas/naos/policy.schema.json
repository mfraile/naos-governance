        "adopter_policy": {"type": "string"},
        "ignored_scan_dirs": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "status_values",
        "revalidation_triggers",
        "external_evidence_verification_default",
        "safe_context_window_chars",
        "safe_context_phrases",
        "overclaim_patterns"
      ],
      "properties": {
        "status_values": {
          "type": "array",
          "items": {"type": "string"}
        },
        "revalidation_triggers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "external_evidence_verification_default": {"type": "string"},
        "safe_context_window_chars": {"type": "integer", "minimum": 0},
        "safe_context_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "disclaimers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "overclaim_patterns": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["default_staleness_days", "external_reference_default_status"],
      "properties": {
        "default_staleness_days": {"type": "integer", "minimum": 0},
        "external_reference_default_status": {"type": "string"}
      }
    },
    "test_evidence": {
      "type": "object",
      "required": ["accepted_types", "coverage_supports_source_default", "global_coverage_maps_sources"],
      "properties": {
        "accepted_types": {
          "type": "array",
          "items": {"type": "string"}
        },
        "coverage_supports_source_default": {"type": "string"},
        "global_coverage_maps_sources": {"type": "boolean"}
      }
    },
    "team_gatekeepers": {
      "type": "object",
      "properties": {
        "team_gatekeeper_config_enabled": {"type": "boolean"},
        "team_gatekeeper_strict_mode": {"type": "boolean"}
      }
    }
  }
