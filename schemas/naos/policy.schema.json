        "memory_mcp_inventory_rules": {"type": "string"},
        "traceability_gap_register_rules": {"type": "string"},
        "challenge_rules": {"type": "string"},
        "install_decision_record_rules": {"type": "string"},
        "effective_policy": {"type": "string"},
        "team_operator_map": {"type": "string"},
        "source_to_test_map": {"type": "string"},
        "dashboard_markdown": {"type": "string"},
        "dashboard_summary_report": {"type": "string"},
        "evidence_dir": {"type": "string"},
