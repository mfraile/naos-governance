{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:gate_input_error:v1",
  "title": "Gate input validation error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "errors",
    "human_review_required",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "naos.gate_input_error.v1"
    },
    "status": {
      "const": "invalid_input"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "const": true
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "severity",
          "message",
          "human_review_required"
        ],
        "properties": {
          "id": {
            "const": "gate_input_invalid"
          },
          "status": {
            "const": "invalid_input"
          },
          "severity": {
            "const": "error"
          },
          "message": {
            "type": "string"
          },
          "human_review_required": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
