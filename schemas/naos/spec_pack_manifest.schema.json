{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:spec_pack_manifest:v1",
  "title": "NAOS Spec-Pack Manifest",
  "description": "Canonical structural contract for NAOS spec-pack templates. The manifest defines filenames, sections, anchors, markers, limitations, and non-claims; it is not approval or requirements completeness proof.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "version", "profiles", "files", "limitations", "not_claimed"],
  "properties": {
    "schema": {"const": "naos.spec_pack_manifest.v1"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "anyOf": [
          {"required": ["required_files"]},
          {"required": ["inherits"]}
        ],
        "properties": {
          "required_files": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/safe_relative_path"}
          },
          "inherits": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_rule"}
    },
    "traceability_codes": {
      "type": "array",
      "items": {"$ref": "#/$defs/traceability_code_rule"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
    },
    "file_rule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "title", "required_profiles"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/safe_relative_path"},
        "title": {"type": "string", "minLength": 1},
        "required_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]}
        },
        "required_sections": {"type": "array", "items": {"type": "string"}},
        "required_markers": {"type": "array", "items": {"type": "string"}},
        "required_patterns": {
          "type": "array",
          "items": {"$ref": "#/$defs/pattern_rule"}
        }
      }
    },
    "pattern_rule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "pattern"],
      "properties": {
        "id": {"type": "string"},
        "pattern": {"type": "string"},
        "description": {"type": "string"},
        "flags": {"type": "array", "items": {"type": "string", "enum": ["multiline", "dotall", "ignorecase"]}}
      }
    },
    "traceability_code_rule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "required_profiles"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "required_profiles": {
          "type": "array",
          "items": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]}
        },
        "definition_source": {"type": "string"},
        "defined_in": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safe_relative_path"}},
        "definition_patterns": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {"$ref": "#/$defs/pattern_rule"}
            ]
          }
        },
        "reference_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safe_relative_path"}},
        "reference_patterns": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {"$ref": "#/$defs/pattern_rule"}
            ]
          }
        }
      }
    }
  }
}
