{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:graph_context_readiness:v1",
  "title": "NAOS Graph Context Readiness Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "rules_path",
    "rules_hash",
    "graph_runtime_enabled",
    "explicit_link_traversal_only",
    "global_graph_scan_allowed",
    "graph_database_allowed",
    "networkx_enabled",
    "graphml_enabled",
    "graph_algorithms_enabled",
    "traversal_limits",
    "allowed_link_types",
    "prohibited_link_types",
    "link_family_posture",
    "source_authority_policy",
    "stale_link_policy",
    "sensitive_link_policy",
    "generated_artifact_feedback_loop_policy",
    "task_scoped_traversal_policy",
    "local_context_index_integration",
    "local_context_query_integration",
    "task_context_pack_integration",
    "semantic_candidate_layer_integration",
    "memory_policy",
    "future_graph_runtime",
    "findings",
    "known_gaps",
    "residual_risks",
    "waivers",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.graph_context_readiness.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["disabled", "readiness_only", "advisory", "review_required", "blocked", "not_configured", "unknown"]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "rules_path": { "type": "string" },
    "rules_hash": { "type": ["string", "null"] },
    "graph_runtime_enabled": { "type": "boolean" },
    "explicit_link_traversal_only": { "type": "boolean" },
    "global_graph_scan_allowed": { "type": "boolean" },
    "graph_database_allowed": { "type": "boolean" },
    "networkx_enabled": { "type": "boolean" },
    "graphml_enabled": { "type": "boolean" },
    "graph_algorithms_enabled": { "type": "boolean" },
    "traversal_limits": { "type": "object" },
    "allowed_link_types": { "type": "array" },
    "prohibited_link_types": { "type": "array" },
    "link_family_posture": { "type": "array" },
    "source_authority_policy": { "type": "object" },
    "stale_link_policy": { "type": "object" },
    "sensitive_link_policy": { "type": "object" },
    "generated_artifact_feedback_loop_policy": { "type": "object" },
    "task_scoped_traversal_policy": { "type": "object" },
    "local_context_index_integration": { "type": "object" },
    "local_context_query_integration": { "type": "object" },
    "task_context_pack_integration": { "type": "object" },
    "semantic_candidate_layer_integration": { "type": "object" },
    "memory_policy": { "type": "object" },
    "future_graph_runtime": { "type": "object" },
    "findings": { "type": "array" },
    "known_gaps": { "type": "array" },
    "residual_risks": { "type": "array" },
    "waivers": { "type": "array" },
    "limitations": { "type": "array" },
    "not_claimed": { "type": "array" },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
