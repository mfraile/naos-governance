{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:plan_coherence:v1",
  "title": "NAOS Plan Coherence Report",
  "description": "Deterministic local review evidence for active task claims, task registry posture, module-header task linkage, and a versioned implementation-readiness planning baseline. It is not work authorization, plan approval, conflict resolution, task closure, or execution sequencing.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "deterministic",
    "summary",
    "implementation_readiness",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required"
  ],
  "properties": {
    "schema": {"const": "naos.plan_coherence.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"type": "string"},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "deterministic": {"const": true},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "blocking": {"type": "integer", "minimum": 0},
        "required": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0},
        "total_findings": {"type": "integer", "minimum": 0},
        "active_claims": {"type": "integer", "minimum": 0},
        "registry_tasks": {"type": "integer", "minimum": 0},
        "tasks_with_file_linkage": {"type": "integer", "minimum": 0},
        "changed_files": {"type": "integer", "minimum": 0},
        "planned_change_paths": {"type": "integer", "minimum": 0},
        "out_of_scope_paths": {"type": "integer", "minimum": 0},
        "unplanned_changed_files": {"type": "integer", "minimum": 0},
        "out_of_scope_changed_files": {"type": "integer", "minimum": 0},
        "parallel_lane_review_findings": {"type": "integer", "minimum": 0},
        "planning_baseline_findings": {"type": "integer", "minimum": 0},
        "implementation_ready": {"type": "boolean"}
      }
    },
    "implementation_readiness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "profile",
        "ledger_path",
        "ledger_source",
        "current_baseline_id",
        "current_baseline_version",
        "state",
        "mode",
        "planning_model",
        "architecture_applicability",
        "source_bindings",
        "digest_candidates",
        "evidence_checks",
        "decision",
        "task_coverage",
        "lineage",
        "does_not_authorize"
      ],
      "properties": {
        "status": {
          "enum": ["not_applicable", "not_configured", "draft_or_discovery", "ready", "review_required", "stale"]
        },
        "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
        "ledger_path": {"type": "string"},
        "ledger_source": {"enum": ["project", "kit_template"]},
        "current_baseline_id": {"type": ["string", "null"]},
        "current_baseline_version": {"type": ["integer", "null"]},
        "state": {"type": ["string", "null"]},
        "mode": {"type": ["string", "null"]},
        "planning_model": {"type": ["string", "null"]},
        "architecture_applicability": {"enum": ["required_by_profile", "not_applicable_by_profile"]},
        "source_bindings": {"type": "array", "items": {"type": "object"}},
        "digest_candidates": {"type": "array", "items": {"type": "object"}},
        "evidence_checks": {"type": "array", "items": {"type": "object"}},
        "decision": {"type": "object"},
        "task_coverage": {"type": "object"},
        "lineage": {"type": "object"},
        "does_not_authorize": {"type": "array", "items": {"type": "string"}}
      }
    },
    "diff_base": {"type": ["string", "null"]},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "alignment_path": {"type": "string"},
    "alignment_source": {"type": "string"},
    "alignment_present": {"type": "boolean"},
    "alignment_parse_error": {"type": ["string", "null"]},
    "planned_change_paths": {"type": "array", "items": {"type": "string"}},
    "out_of_scope_paths": {"type": "array", "items": {"type": "string"}},
    "parallel_lane_opportunity": {"type": "object"},
    "parallel_lane_review": {"type": "object"},
    "unplanned_changed_files": {"type": "array", "items": {"type": "string"}},
    "out_of_scope_changed_files": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {
      "type": "array",
      "items": {"type": "string"},
      "allOf": [
        {"contains": {"const": "plan approval"}},
        {"contains": {"const": "implementation approval"}},
        {"contains": {"const": "task closure"}},
        {"contains": {"const": "merge or release authority"}}
      ]
    },
    "human_review_required": {"type": "boolean"}
  }
}
