{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:repository_intelligence_context:v1",
  "title": "NAOS Repository Intelligence Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "project_root"],
  "properties": {
    "schema": {"const": "naos.repository_intelligence_context.v1"},
    "status": {"enum": ["not_configured", "validated", "validated_current", "stale", "invalid", "recovery_required"]},
    "project_root": {"type": "string"},
    "effective_source_sha256": {"$ref": "#/$defs/sha256"},
    "generation_id": {"type": "string"},
    "current_source_sha256": {"$ref": "#/$defs/sha256"},
    "generation": {
      "type": "object",
      "required": ["generation_id", "generation_content_sha256", "manifest_path", "manifest_file_sha256", "manifest_sha256", "validation_receipt_path", "validation_receipt_file_sha256", "validation_receipt_sha256", "activation_receipt_path", "activation_receipt_file_sha256", "activation_receipt_sha256", "transaction_id", "plan_sha256", "bundle_sha256", "profile", "purpose", "component_mode", "validation_status", "effective_source_sha256", "source_status"],
      "properties": {
        "generation_id": {"type": "string"},
        "generation_content_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_path": {"type": "string"},
        "manifest_file_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "validation_receipt_path": {"type": "string"},
        "validation_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
        "validation_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "activation_receipt_path": {"type": "string"},
        "activation_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
        "activation_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "transaction_id": {"type": "string", "pattern": "^RIT-[0-9a-f]{24}$"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
        "purpose": {"type": "string"},
        "component_mode": {"enum": ["auto", "baseline", "graph"]},
        "validation_status": {"const": "passed"},
        "effective_source_sha256": {"$ref": "#/$defs/sha256"},
        "source_status": {"enum": ["current", "not_checked"]}
      },
      "additionalProperties": false
    },
    "usage_scope": {"type": "array", "items": {"type": "string"}},
    "components": {"type": "object"},
    "coverage": {"type": "object"},
    "candidate_reference_count": {"type": "integer", "minimum": 0},
    "candidate_only": {"type": "boolean"},
    "candidate_references": {"type": "array", "maxItems": 0},
    "source_artifacts_remain_authoritative": {"type": "boolean"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "finding": {"type": "string"},
    "sqlite_validation": {"type": "object"},
    "networkx_graphml_validation": {"type": "object"},
    "provenance_validation": {"type": "object"},
    "transaction": {"type": "object"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
