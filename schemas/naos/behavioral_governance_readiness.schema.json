{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:behavioral_governance_readiness:v1",
  "title": "NAOS Behavioral Governance Readiness Report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "rules_path",
    "rules_hash",
    "baseline_state_path",
    "baseline_state_present",
    "current_fingerprints",
    "readiness_inputs",
    "impacter_review",
    "cost_posture",
    "runtime_posture",
    "advisory_boundary",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "recommended_next_commands",
    "next_actions",
    "advisory_non_deterministic_boundary",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": { "const": "naos.behavioral_governance_readiness.v1" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string", "enum": ["quickstart", "lite", "standard", "assured"] },
    "status": {
      "type": "string",
      "enum": [
        "not_configured",
        "not_ready",
        "ready_to_baseline",
        "baseline_current",
        "baseline_stale",
        "maintenance_recommended",
        "maintenance_required"
      ]
    },
    "naos_root": { "type": "string" },
    "project_root": { "type": "string" },
    "rules_path": { "type": "string" },
    "rules_source": { "type": "string" },
    "rules_hash": { "type": ["string", "null"] },
    "baseline_state_path": { "type": "string" },
    "baseline_state_present": { "type": "boolean" },
    "baseline_state_error": { "type": ["string", "null"] },
    "baseline_state": { "type": "object" },
    "current_fingerprints": { "type": "object" },
    "fingerprinted_paths": { "type": "array", "items": { "type": "object" } },
    "readiness_inputs": { "type": "array", "items": { "type": "object" } },
    "impacter_review": { "type": "object" },
    "cost_posture": { "type": "object" },
    "runtime_posture": { "type": "object" },
    "advisory_boundary": { "type": "object" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "known_gaps": { "type": "array", "items": { "type": "string" } },
    "residual_risks": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "not_claimed": { "type": "array", "items": { "type": "string" } },
    "recommended_next_commands": { "type": "array", "items": { "type": "object" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "advisory_non_deterministic_boundary": { "type": "object" },
    "human_review_required": { "type": "boolean" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
