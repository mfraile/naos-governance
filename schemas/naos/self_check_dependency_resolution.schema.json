{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:self_check_dependency_resolution:v1",
  "title": "NAOS full self-check dependency resolution",
  "description": "A source-replayed consumer resolution; raw historical producer failures remain unchanged. Schema conformance alone confers no readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "project_root",
    "naos_root",
    "context",
    "status",
    "refusals",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "naos.self_check_dependency_resolution.v1"
    },
    "generated_at": {
      "type": "string",
      "pattern": "Z$"
    },
    "profile": {
      "enum": [
        "quickstart",
        "lite",
        "standard",
        "assured"
      ]
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "naos_root": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pr_base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_head_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "graph_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "enum": [
        "resolved",
        "unresolved"
      ]
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_check_reference",
        "self_check_sha256",
        "source_bindings",
        "source_binding_sha256",
        "expected_check_ids",
        "independent_checks",
        "gate_obligations",
        "current_classification",
        "maturity_internal_slots",
        "aggregate_snapshots",
        "resolved_observations",
        "raw_producer_status",
        "raw_summary",
        "selected_script_plan",
        "attestation_collection"
      ],
      "properties": {
        "self_check_reference": {
          "type": "string",
          "minLength": 1
        },
        "self_check_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "source_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_check_ids": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "independent_checks": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object"
          }
        },
        "gate_obligations": {
          "type": "object"
        },
        "current_classification": {
          "type": "object"
        },
        "maturity_internal_slots": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "aggregate_snapshots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "M",
            "R"
          ],
          "properties": {
            "M": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "report_key",
                "content_sha256",
                "payload_sha256",
                "raw_report",
                "raw_check"
              ],
              "properties": {
                "report_key": {
                  "type": "string"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "raw_report": {
                  "type": "object"
                },
                "raw_check": {
                  "type": "object"
                }
              }
            },
            "R": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "report_key",
                "content_sha256",
                "payload_sha256",
                "raw_report",
                "raw_check"
              ],
              "properties": {
                "report_key": {
                  "type": "string"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "raw_report": {
                  "type": "object"
                },
                "raw_check": {
                  "type": "object"
                }
              }
            }
          }
        },
        "resolved_observations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "raw_producer_status": {
          "type": "string"
        },
        "raw_summary": {
          "type": "object"
        },
        "selected_script_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "attestation_collection": {
          "type": "object"
        },
        "l3_gate_obligations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "gate_reports",
            "internal_slots",
            "selected_gate_ids",
            "ready_link_ids",
            "independent_rows",
            "freshness_window_days"
          ],
          "properties": {
            "status": {
              "const": "independent_l3_gate_obligations_satisfied"
            },
            "gate_reports": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "internal_slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "gate_id",
                  "reference"
                ],
                "properties": {
                  "gate_id": {
                    "const": "G6"
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "selected_gate_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "ready_link_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "independent_rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "status",
                  "readiness",
                  "severity"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "ready",
                      "not_applicable"
                    ]
                  },
                  "readiness": {
                    "enum": [
                      "ready",
                      "not_applicable"
                    ]
                  },
                  "severity": {
                    "enum": [
                      "none",
                      "advisory",
                      "warning",
                      "required",
                      "blocking"
                    ]
                  }
                }
              }
            },
            "freshness_window_days": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "required": [
          "proof"
        ],
        "properties": {
          "refusals": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "refusals": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
