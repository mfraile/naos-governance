{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:evidence_pack:v1",
  "title": "NAOS Evidence Pack Report",
  "description": "Schema for the evidence pack emitted by scripts/naos_evidence_export.py. The pack aggregates review evidence and residual risks; it does not prove completeness, compliance, runtime safety, approval, certification, or release readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "project_root",
    "policy",
    "semantics",
    "artifacts",
    "freshness",
    "findings",
    "external_references",
    "exceptions_waivers",
    "known_gaps",
    "residual_risks",
    "summary",
    "limitations",
    "adapter_coherence",
    "ac_completion_evidence",
    "agent_trace_validation",
    "agentic_workflow",
    "ai_code_provenance",
    "audit_log",
    "behavioral_governance_readiness",
    "calibration_shadow",
    "compliance_posture",
    "composed_traceability",
    "cross_harness_review_readiness",
    "deterministic_hygiene",
    "evidence_attestation",
    "evidence_classification",
    "evidence_conflicts",
    "evidence_verification",
    "failure_mode_observations",
    "grader_assessment",
    "graph_context_query",
    "graph_context_readiness",
    "harness_trace_import",
    "learning_loop_review",
    "llm_grader_readiness",
    "local_context_index",
    "local_context_query",
    "memory_context_readiness",
    "memory_provider_access",
    "memory_use_policy",
    "operator_attribution",
    "plan_coherence",
    "policy_overrides",
    "pr_governance",
    "pr_risk_classification",
    "pre_implementation_alignment",
    "professional_adoption",
    "research_record",
    "semantic_candidate_layer",
    "session_identity",
    "session_lifecycle",
    "spec_assembly_worksheet",
    "spec_cascade_coherence",
    "spec_pack_contract",
    "spec_pack_materialization",
    "sqlite_write_coordination",
    "static_grader",
    "task_claims",
    "task_context_pack",
    "task_lifecycle"
  ],
  "properties": {
    "schema": {"const": "naos.evidence_pack.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"type": "string"},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "policy": {"type": "object"},
    "semantics": {"type": "object"},
    "artifacts": {"type": "object"},
    "freshness": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "external_references": {"type": "array", "items": {"type": "object"}},
    "exceptions_waivers": {"type": "array", "items": {"type": ["object", "string"]}},
    "known_gaps": {"type": "array", "items": {"type": ["object", "string"]}},
    "residual_risks": {"type": "array", "items": {"type": ["object", "string"]}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocking",
        "required",
        "warnings",
        "advisory",
        "total_findings",
        "artifacts",
        "present_artifacts",
        "missing_artifacts",
        "not_configured_artifacts",
        "stale_artifacts",
        "external_references",
        "external_references_unverified"
      ],
      "properties": {
        "blocking": {"type": "integer", "minimum": 0},
        "required": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0},
        "total_findings": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "integer", "minimum": 0},
        "present_artifacts": {"type": "integer", "minimum": 0},
        "missing_artifacts": {"type": "integer", "minimum": 0},
        "not_configured_artifacts": {"type": "integer", "minimum": 0},
        "stale_artifacts": {"type": "integer", "minimum": 0},
        "external_references": {"type": "integer", "minimum": 0},
        "external_references_unverified": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "adapter_coherence": {"type": "object"},
    "ac_completion_evidence": {"type": "object"},
    "agent_trace_validation": {"type": "object"},
    "agentic_workflow": {"type": "object"},
    "ai_code_provenance": {"type": "object"},
    "audit_log": {"type": "object"},
    "behavioral_governance_readiness": {"type": "object"},
    "calibration_shadow": {"type": "object"},
    "compliance_posture": {"type": "object"},
    "composed_traceability": {"type": "object"},
    "cross_harness_review_readiness": {"type": "object"},
    "deterministic_hygiene": {"type": "object"},
    "evidence_attestation": {"type": "object"},
    "evidence_classification": {"type": "object"},
    "evidence_conflicts": {"type": "object"},
    "evidence_verification": {"type": "object"},
    "failure_mode_observations": {"type": "object"},
    "grader_assessment": {"type": "object"},
    "graph_context_query": {"type": "object"},
    "graph_context_readiness": {"type": "object"},
    "harness_trace_import": {"type": "object"},
    "learning_loop_review": {"type": "object"},
    "llm_grader_readiness": {"type": "object"},
    "local_context_index": {"type": "object"},
    "local_context_query": {"type": "object"},
    "memory_context_readiness": {"type": "object"},
    "memory_provider_access": {"type": "object"},
    "memory_use_policy": {"type": "object"},
    "operator_attribution": {"type": "object"},
    "plan_coherence": {"type": "object"},
    "policy_overrides": {"type": "object"},
    "pr_governance": {"type": "object"},
    "pr_risk_classification": {"type": "object"},
    "pre_implementation_alignment": {"type": "object"},
    "professional_adoption": {"type": "object"},
    "research_record": {"type": "object"},
    "semantic_candidate_layer": {"type": "object"},
    "session_identity": {"type": "object"},
    "session_lifecycle": {"type": "object"},
    "spec_assembly_worksheet": {"type": "object"},
    "spec_cascade_coherence": {"type": "object"},
    "spec_pack_contract": {"type": "object"},
    "spec_pack_materialization": {"type": "object"},
    "sqlite_write_coordination": {"type": "object"},
    "static_grader": {"type": "object"},
    "task_claims": {"type": "object"},
    "task_context_pack": {"type": "object"},
    "task_lifecycle": {"type": "object"}
  }
}
