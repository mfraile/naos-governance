{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:api_symbol_reality_manifest:v1",
  "title": "NAOS API Symbol Reality Manifest",
  "description": "Explicit declarations of Python API symbols that should be checked by local source inspection. Missing or empty manifests are not completion, API, package, semantic, behavioral, approval, certification, or compliance proof.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "symbols"],
  "properties": {
    "schema": {"const": "naos.api_symbol_reality_manifest.v1"},
    "symbols": {
      "type": "array",
      "items": {"$ref": "#/$defs/symbol"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "symbol"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "package": {"type": "string"},
        "module": {"type": "string", "minLength": 1},
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "source_type": {"type": "string", "enum": ["source_path", "installed_distribution"]},
        "source_path": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
