{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:pre_implementation_alignment_review:v1",
  "title": "NAOS Pre-Implementation Alignment Review Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "naos_root",
    "alignment_path",
    "alignment_present",
    "alignment_valid",
    "mode",
    "task_id",
    "feature_name",
    "question_coverage",
    "greenfield_findings",
    "brownfield_findings",
    "feature_findings",
    "missing_required_questions",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.pre_implementation_alignment_review.v1"},
    "generated_at": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {
      "enum": ["ready", "advisory", "review_required", "missing_alignment", "invalid_alignment", "missing_required_questions", "unknown"]
    },
    "naos_root": {"type": "string"},
    "alignment_path": {"type": "string"},
    "alignment_present": {"type": "boolean"},
    "alignment_valid": {"type": "boolean"},
    "mode": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "feature_name": {"type": ["string", "null"]},
    "question_coverage": {"type": "object"},
    "implementation_scope_paths": {"type": "object"},
    "parallel_lane_opportunity": {"type": "object"},
    "greenfield_findings": {"type": "array", "items": {"type": "object"}},
    "brownfield_findings": {"type": "array", "items": {"type": "object"}},
    "feature_findings": {"type": "array", "items": {"type": "object"}},
    "missing_required_questions": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  }
}
