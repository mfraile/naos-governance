{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:policy_override_merge:v1",
  "title": "NAOS Policy Override Merge Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at",
    "profile",
    "status",
    "project_root",
    "naos_root",
    "default_policy_path",
    "override_dir",
    "team_operator_map_path",
    "team_operator_map",
    "operator_id",
    "operator_source",
    "operator_attribution_status",
    "global_overlay_files",
    "team_overlay_files",
    "operator_overlay_files",
    "team_operator_map_present",
    "team_id",
    "team_ids",
    "team_resolution_source",
    "operator_overlay_id",
    "operator_overlay_resolution_source",
    "overlay_precedence",
    "overlay_scope",
    "overlay_scopes",
    "applied_overlay_scopes",
    "override_files",
    "ignored_files",
    "missing_override_dir",
    "merge_strategy",
    "allowed_override_paths",
    "protected_paths",
    "effective_policy_path",
    "override_summary",
    "protected_invariant_violations",
    "schema_validation_results",
    "conflicts",
    "findings",
    "known_gaps",
    "residual_risks",
    "limitations",
    "not_claimed",
    "human_review_required",
    "summary"
  ],
  "properties": {
    "schema": {"const": "naos.policy_override_merge.v1"},
    "generated_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "advisory",
        "review_required",
        "no_overrides",
        "invalid_override",
        "protected_invariant_violation",
        "not_configured",
        "disabled",
        "blocked",
        "unknown"
      ]
    },
    "project_root": {"type": "string"},
    "naos_root": {"type": "string"},
    "default_policy_path": {"type": ["string", "null"]},
    "override_dir": {"type": "string"},
    "team_operator_map_path": {"type": "string"},
    "team_operator_map": {"type": "object"},
    "operator_id": {"type": ["string", "null"]},
    "operator_source": {"type": ["string", "null"]},
    "operator_attribution_status": {"type": ["string", "null"]},
    "global_overlay_files": {"type": "array", "items": {"type": "string"}},
    "team_overlay_files": {"type": "array", "items": {"type": "string"}},
    "operator_overlay_files": {"type": "array", "items": {"type": "string"}},
    "team_operator_map_present": {"type": "boolean"},
    "team_id": {"type": ["string", "null"]},
    "team_ids": {"type": "array", "items": {"type": "string"}},
    "team_resolution_source": {"type": "string"},
    "operator_overlay_id": {"type": ["string", "null"]},
    "operator_overlay_resolution_source": {"type": "string"},
    "overlay_precedence": {"type": "array", "items": {"type": "string"}},
    "overlay_scope": {"type": "object"},
    "overlay_scopes": {"type": "array", "items": {"type": "object"}},
    "applied_overlay_scopes": {"type": "array", "items": {"type": "string"}},
    "override_files": {"type": "array", "items": {"type": "object"}},
    "ignored_files": {"type": "array", "items": {"type": "object"}},
    "missing_override_dir": {"type": "boolean"},
    "merge_strategy": {"type": "object"},
    "allowed_override_paths": {"type": "array", "items": {"type": "string"}},
    "protected_paths": {"type": "array", "items": {"type": "string"}},
    "effective_policy_path": {"type": ["string", "null"]},
    "override_summary": {"type": "object"},
    "protected_invariant_violations": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "schema_validation_results": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "known_gaps": {"type": "array", "items": {"type": "object"}},
    "residual_risks": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "summary": {"type": "object"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "status", "message"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"type": "string", "enum": ["none", "advisory", "warning", "required", "blocking"]},
        "status": {"type": "string"},
        "message": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "override_file": {"type": ["string", "null"]},
        "required_next_actions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
