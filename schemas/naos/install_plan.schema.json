{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naos-governance:schemas:naos:install_plan:v1",
  "title": "NAOS Install Plan Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "generated_at", "profile", "status", "command", "mode", "naos_root", "project_root", "human_review_required", "not_claimed", "limitations", "findings", "summary"],
  "properties": {
    "schema": {"const": "naos.install_plan.v1"},
    "generated_at": {"type": "string"},
    "profile": {"enum": ["quickstart", "lite", "standard", "assured"]},
    "status": {"enum": ["ready", "advisory", "review_required", "warning", "invalid_config", "blocked", "unknown"]},
    "command": {"const": "install-plan"},
    "mode": {"type": "string"},
    "naos_root": {"type": "string"},
    "project_root": {"type": "string"},
    "session_id": {"type": ["string", "null"]},
    "generated_by": {"type": "object"},
    "human_review_required": {"type": "boolean"},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array"},
    "residual_risks": {"type": "array"},
    "summary": {"type": "object"},
    "activation_plan": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "init_command": {"type": "string"},
        "init_command_is_template": {"type": "boolean"},
        "required_owner_choices": {"type": "array", "items": {"enum": ["--archetype", "--backend"]}},
        "activate_after_review_command": {"type": "string"},
        "hook_ci_boundary": {"type": "string"},
        "write_posture": {"type": "string"}
      }
    },
    "repository_intelligence": {"type": ["object", "null"]}
  }
}
