{
  "schema": "naos.claude_code_hook_template.v2",
  "description": "Optional assured-profile NAOS hook references for Claude Code. Review and merge manually; these remain convenience hooks, not authority.",
  "activation": "manual_review_required",
  "profile": "assured",
  "not_claimed": [
    "automatic hook activation",
    "silent context injection",
    "memory write-back",
    "provider/model/API calls",
    "approval",
    "certification",
    "proof of compliance",
    "official Claude support",
    "official Anthropic support"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/naos/integrations/claude-code/hooks/dispatch.py",
              "--event",
              "session-start",
              "--profile",
              "assured"
            ],
            "timeout": 35
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/naos/integrations/claude-code/hooks/dispatch.py",
              "--event",
              "pre-tool-edit",
              "--profile",
              "assured"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/naos/integrations/claude-code/hooks/dispatch.py",
              "--event",
              "pre-tool-bash",
              "--profile",
              "assured"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/naos/integrations/claude-code/hooks/dispatch.py",
              "--event",
              "post-tool-write",
              "--profile",
              "assured"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/naos/integrations/claude-code/hooks/dispatch.py",
              "--event",
              "pre-compact",
              "--profile",
              "assured"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/naos/integrations/claude-code/hooks/dispatch.py",
              "--event",
              "session-end",
              "--profile",
              "assured"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
