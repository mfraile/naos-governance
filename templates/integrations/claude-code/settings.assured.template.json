{
  "schema": "naos.claude_code_hook_template.v1",
  "description": "Optional assured-profile NAOS hook references for Claude Code. Review and merge manually; these remain convenience hooks, not authority.",
  "activation": "manual_review_required",
  "profile": "assured",
  "not_claimed": [
    "automatic hook activation",
    "silent context injection",
    "memory write-back",
    "provider/model/API calls",
    "approval",
    "certification",
    "proof of compliance",
    "official Claude support",
    "official Anthropic support"
  ],
  "hooks": {
    "PreSession": [
      {
        "command": "NAOS_PROFILE=assured naos/integrations/claude-code/hooks/pre-session.sh"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "command": "NAOS_PROFILE=assured naos/integrations/claude-code/hooks/pre-tool-edit.sh"
      },
      {
        "matcher": "Bash",
        "command": "NAOS_PROFILE=assured naos/integrations/claude-code/hooks/pre-tool-bash.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "command": "NAOS_PROFILE=assured naos/integrations/claude-code/hooks/post-tool-write.sh"
      }
    ],
    "PreCompact": [
      {
        "command": "NAOS_PROFILE=assured naos/integrations/claude-code/hooks/pre-compact.sh"
      }
    ],
    "Stop": [
      {
        "command": "NAOS_PROFILE=assured naos/integrations/claude-code/hooks/stop.sh"
      }
    ]
  }
}
