# Makefile.naos — NAOS Governance Targets
# Include from your main Makefile: include Makefile.naos
#
# Prerequisites: Python scripts under scripts/workflows/ and scripts/
# NAOS_ROOT: override via environment variable (default: naos)
# NAOS_PROFILE: quickstart | lite | standard | assured (default: quickstart)
# NAOS_POLICY: optional explicit policy path
# NAOS_STRICT: set to 1 to enable strict validator exit behavior where supported
#
# Usage:
#   make -f Makefile.naos gov-refresh       - full governance sync (run after any TASK_REGISTRY change)
#   make -f Makefile.naos gov-full          - gov-refresh + truth validation
#   make -f Makefile.naos gov-status        - print counts from PROJECT_STATUS.md
#   make -f Makefile.naos drift-check       - check for signs of governance drift
#   make -f Makefile.naos semantic-audit    - optional project-configured AI code quality review
#   make -f Makefile.naos validate-all      - run all non-AI validators
#   make -f Makefile.naos naos-readiness    - check lifecycle gates before task/baseline/drift work
#   make -f Makefile.naos function-index    - regenerate FUNCTION_INDEX.yaml
#   make -f Makefile.naos naos-claims       - validate project-local claims
#   make -f Makefile.naos naos-self-check   - run control-plane self-conformance
#   make -f Makefile.naos naos-capability-maturity - evaluate maturity readiness
#   make -f Makefile.naos naos-systemic-impact - evaluate systemic impact review obligations
#   make -f Makefile.naos naos-module-headers - evaluate canonical module-header traceability
#   make -f Makefile.naos naos-spec-pack-contract - validate spec-pack template contract
#   make -f Makefile.naos naos-spec-pack-materialize - preview missing profile-required spec files
#     optional: SPEC_PACK_MATERIALIZE_ARGS="" to copy missing files intentionally
#   make -f Makefile.naos naos-spec-assembly-worksheet - map adoption evidence to specs for review
#   make -f Makefile.naos naos-spec-cascade - evaluate spec-cascade coherence
#   make -f Makefile.naos naos-control-plane-review - evaluate control-plane review/research routing
#   make -f Makefile.naos naos-secure-coding-controls - validate bounded control/evidence routing
#   make -f Makefile.naos naos-setup-recommendations - recommend setup modules and next actions
#   make -f Makefile.naos naos-governance-bypass-posture - report local hook/CI bypass posture
#   make -f Makefile.naos naos-external-evidence-ingest EXTERNAL_EVIDENCE_SOURCE=scan.sarif - summarize local SARIF evidence
#   make -f Makefile.naos naos-evidence-attestation - generate local digest/reviewer metadata report
#   make -f Makefile.naos naos-evidence-sign - emit adopter-signable evidence envelope
#   make -f Makefile.naos naos-evidence-verify - verify local tamper-evidence and report signature-entry presence
#   make -f Makefile.naos naos-evidence-conflicts - detect deterministic evidence/review conflicts
#   make -f Makefile.naos naos-memory-readiness - evaluate memory/context governance readiness
#   make -f Makefile.naos naos-memory-access - evaluate declared provider/MCP posture and unverified fields
#   make -f Makefile.naos naos-memory-use-policy - evaluate memory-use policy/review readiness
#   make -f Makefile.naos naos-learning-loop-review - review governed learning lifecycle records
#   make -f Makefile.naos naos-adapter-coherence - review Codex/Claude/plugin/adapter coherence
#   make -f Makefile.naos naos-task-context TASK=T-XXX - generate bounded task context pack
#   make -f Makefile.naos naos-task-lifecycle TASK=T-XXX - inspect exact active/completed task lifecycle state
#   make -f Makefile.naos naos-task-complete TASK=T-XXX - record native task completion
#   make -f Makefile.naos naos-research-record RESEARCH_RECORD=path - validate structured research
#   make -f Makefile.naos naos-task-claim TASK=T-XXX - claim task coordination metadata
#   make -f Makefile.naos naos-task-release TASK=T-XXX - release task coordination metadata
#   make -f Makefile.naos naos-task-claims - summarize task claims
#   make -f Makefile.naos naos-context-index - build generated local context index
#   make -f Makefile.naos naos-context-query QUERY="..." - query generated local context candidates
#   make -f Makefile.naos naos-repository-intelligence-plan - inspect and write a no-target-mutation activation plan
#   make -f Makefile.naos naos-semantic-candidates - evaluate future semantic candidate readiness
#   make -f Makefile.naos naos-graph-context - evaluate future graph-context readiness
#   make -f Makefile.naos naos-graph-query TASK=T-001 - query bounded graph-context candidates
#   make -f Makefile.naos naos-session-id - create/reuse a session id for namespaced reports
#   make -f Makefile.naos naos-operator-attribution - resolve local operator attribution
#   make -f Makefile.naos naos-session-start TASK=T-001 - generate session-start checklist
#   make -f Makefile.naos naos-session-checkpoint TASK=T-001 - generate checkpoint checklist
#   make -f Makefile.naos naos-session-end TASK=T-001 - generate session-end checklist
#   make -f Makefile.naos naos-audit-log - summarize append-only audit log events
#   make -f Makefile.naos naos-agent-traces - validate declared agent trace events
#   make -f Makefile.naos naos-harness-trace-import HARNESS_TRACE_SOURCE=naos/harness_traces/example.jsonl - import local harness traces
#   make -f Makefile.naos naos-ai-surface-budget - evaluate AI-surface context budget and health
#   make -f Makefile.naos naos-static-grader - run deterministic StaticGrader structural checks
#   make -f Makefile.naos naos-grader-assessment MODE=audit - build deterministic audit/drift/assess review input
#   make -f Makefile.naos naos-model-policy - review model-provider declarations without provider calls
#   make -f Makefile.naos naos-model-telemetry - review local model telemetry evidence
#   make -f Makefile.naos naos-failure-mode-observations - aggregate local report findings by failure mode
#   make -f Makefile.naos naos-opencode-config-hygiene - review optional OpenCode config hygiene without runtime activation
#   make -f Makefile.naos naos-design-traceability - review UI spec-object traceability declarations
#   make -f Makefile.naos naos-ui-experience-quality - review UI quality evidence declarations
#   make -f Makefile.naos naos-llm-grader-readiness - report readiness-only LLMGrader posture
#   make -f Makefile.naos naos-behavioral-readiness - report behavioral baseline readiness and impacters
#   make -f Makefile.naos naos-plan-coherence - review task claims against task registry/module linkage
#     optional: PLAN_DIFF_BASE=<ref> to compare changed files with PRE_IMPLEMENTATION_ALIGNMENT path declarations
#   make -f Makefile.naos naos-package-reality - review package, SBOM, provenance, hash, and opt-in registry evidence
#   make -f Makefile.naos naos-api-symbol-reality - verify declared Python API symbols without importing targets
#   make -f Makefile.naos naos-ac-completion-evidence - validate declared AC completion evidence
#     optional: PACKAGE_REALITY_ARGS="--scan-docs" or "--registry-mode online --allow-network"
#   make -f Makefile.naos naos-sarif-export - export NAOS findings to SARIF 2.1.0
#   make -f Makefile.naos naos-policy-overrides - validate static/global/team/operator YAML policy overlays
#     optional: TEAM_ID=<team-id> OPERATOR_ID=<operator-id> OPERATOR_OVERLAY_ID=<overlay-id>
#   make -f Makefile.naos naos-dashboard    - refresh DASHBOARD.md + reports/dashboard_summary.json
#   make -f Makefile.naos naos-pr-governance-summary - summarize PR governance evidence
#   make -f Makefile.naos naos-agentic-workflow-review - review governed agentic coding workflow controls
#   make -f Makefile.naos naos-pre-implementation-alignment-review - review Pre-Implementation Alignment
#   make -f Makefile.naos naos-cross-harness-review-readiness - report future cross-harness/DSSE readiness
#   make -f Makefile.naos naos-adopt MODE=brownfield - orchestrate professional adoption evidence
#   make -f Makefile.naos naos-preflight - run adoption preflight checks
#   make -f Makefile.naos naos-intake ANSWERS=naos/intake_answers.yaml - capture guided intake
#   make -f Makefile.naos naos-install-plan - build reviewable install plan
#   make -f Makefile.naos naos-existing-resource-inventory - inventory existing docs/specs/tests/source
#   make -f Makefile.naos naos-ai-artifact-inventory - inventory AI prompts/rules/hooks
#   make -f Makefile.naos naos-ai-artifact-reconcile - record AI artifact disposition decisions
#   make -f Makefile.naos naos-ai-code-provenance - compose review-only AI code provenance evidence
#   make -f Makefile.naos naos-compliance-posture - compose review-only compliance posture evidence
#   make -f Makefile.naos naos-memory-resource-inventory - inventory Engram/memory/MCP posture
#   make -f Makefile.naos naos-memory-resource-reconcile - record memory/MCP decisions
#   make -f Makefile.naos naos-mcp-resource-inventory - inventory declared MCP configs
#   make -f Makefile.naos naos-brownfield-baseline - build brownfield baseline evidence
#   make -f Makefile.naos naos-requirements-reconstruct - emit candidate requirements for review
#   make -f Makefile.naos naos-traceability-gap-register - emit traceability gaps
#   make -f Makefile.naos naos-install-decision-record - record adoption decisions
#   make -f Makefile.naos naos-context-challenge - challenge context before build
#   make -f Makefile.naos naos-repo-context-challenge - challenge brownfield repo context
#   make -f Makefile.naos naos-plan-challenge - challenge install/implementation plan
#   make -f Makefile.naos naos-decision-probe - probe unresolved decisions
#   make -f Makefile.naos naos-planning-gate-review - review planning gate evidence
#   make -f Makefile.naos admissibility-pack - bundle review-ready governance evidence

NAOS_ROOT    ?= naos
NAOS_PROFILE ?= quickstart
NAOS_POLICY  ?=
NAOS_STRICT  ?=
PYTHON       ?= python
ANSWERS      ?=
DECISION     ?=
EXTERNAL_EVIDENCE_SOURCE ?=
PLAN_DIFF_BASE ?=
SPEC_PACK_MATERIALIZE_ARGS ?= --dry-run
SPEC_ASSEMBLY_WORKSHEET_ARGS ?=
HARNESS_TRACE_SOURCE ?=
HARNESS_TRACE_IMPORT_ARGS ?=
RESEARCH_RECORD ?=
REPOSITORY_INTELLIGENCE_ARGS ?=

NAOS_POLICY_ARG := $(if $(NAOS_POLICY),--policy $(NAOS_POLICY),)
NAOS_STRICT_ARG := $(if $(NAOS_STRICT),--strict,)
NAOS_COMMON_ARGS := --profile $(NAOS_PROFILE) --naos-root $(NAOS_ROOT) $(NAOS_POLICY_ARG)
NAOS_PLAN_DIFF_BASE_ARG := $(if $(PLAN_DIFF_BASE),--diff-base $(PLAN_DIFF_BASE),)
PACKAGE_REALITY_ARGS ?=
API_SYMBOL_REALITY_ARGS ?=
NAOS_ADOPTION_MODE := $(if $(MODE),$(MODE),greenfield)
NAOS_ADOPTION_ARGS := $(NAOS_COMMON_ARGS) $(NAOS_STRICT_ARG) --mode $(NAOS_ADOPTION_MODE) --no-prompt $(if $(ANSWERS),--answers $(ANSWERS),)

# [ADAPT: Update CONDA_ENV if you use conda; or set PYTHON directly]
# CONDA_ENV ?= myproject-env
# PYTHON    = conda run -n $(CONDA_ENV) python

.PHONY: gov-refresh gov-full gov-status drift-check semantic-audit \
	validate-all function-index naos-audit naos-conformance admissibility-pack \
	naos-readiness naos-claims naos-self-check naos-roadmap-crosswalk \
	naos-capability-maturity naos-systemic-impact naos-module-headers \
	naos-spec-pack-contract naos-spec-pack-materialize naos-spec-assembly-worksheet \
	naos-spec-cascade naos-control-plane-review naos-secure-coding-controls naos-setup-recommendations naos-governance-bypass-posture naos-external-evidence-ingest naos-evidence-attestation \
	naos-evidence-sign naos-evidence-verify naos-evidence-conflicts \
	naos-memory-readiness naos-memory-access naos-memory-use-policy naos-learning-loop-review naos-adapter-coherence naos-task-context naos-task-lifecycle naos-task-complete naos-research-record naos-composed-traceability naos-task-claim naos-task-release naos-task-claims naos-context-index naos-context-query naos-repository-intelligence-plan \
	naos-semantic-candidates naos-graph-context naos-graph-query \
	naos-session-id naos-operator-attribution naos-session-start naos-session-checkpoint naos-session-end naos-audit-log \
	naos-agent-traces naos-harness-trace-import naos-ai-surface-budget naos-static-grader naos-grader-assessment naos-ai-component-inventory naos-agent-sponsor-registry naos-aivss-verify naos-model-policy naos-model-telemetry naos-failure-mode-observations naos-design-traceability naos-ui-experience-quality naos-llm-grader-readiness naos-behavioral-readiness naos-plan-coherence naos-sarif-export naos-policy-overrides \
	naos-function-index-health naos-test-evidence-map naos-test-evidence \
	naos-ac-completion-evidence naos-package-reality naos-api-symbol-reality \
	naos-gate-status naos-gate-evaluate naos-evidence-pack naos-dashboard \
	naos-pr-risk-classify naos-pr-governance-summary naos-agentic-workflow-review naos-pre-implementation-alignment-review \
	naos-cross-harness-review-readiness \
	naos-adopt naos-preflight naos-intake naos-install-plan \
	naos-existing-resource-inventory naos-ai-artifact-inventory naos-ai-artifact-reconcile naos-ai-code-provenance naos-compliance-posture \
	naos-memory-resource-inventory naos-memory-resource-reconcile naos-mcp-resource-inventory \
	naos-brownfield-baseline naos-requirements-reconstruct naos-traceability-gap-register \
	naos-install-decision-record naos-context-challenge naos-repo-context-challenge \
	naos-plan-challenge naos-decision-probe naos-planning-gate-review \
	naos-help

# ─── Core Governance ────────────────────────────────────────────────────────

gov-refresh: ## Sync TASK_REGISTRY → all derived PM files (run after any task change)
	@echo "🔄 [gov-refresh] Syncing derived PM files..."
	"$(PYTHON)" scripts/workflows/sync_from_registry.py
	@echo "🔄 [gov-refresh] Syncing spec statuses..."
	@if [ -f scripts/workflows/sync_spec_statuses.py ] && [ -f specs/03-requirements.md ]; then \
		"$(PYTHON)" scripts/workflows/sync_spec_statuses.py; \
	else \
		echo "    skip (spec-sync not applicable for this project)"; \
	fi
	@echo "🔄 [gov-refresh] Refreshing module headers..."
	# [ADAPT: uncomment if you use header sync script]
	# "$(PYTHON)" scripts/naos_sync_headers.py
	@echo "🔄 [gov-refresh] Emitting AI tool-surface catalogue..."
	@if [ -f scripts/naos_emit_capabilities.py ]; then \
		"$(PYTHON)" scripts/naos_emit_capabilities.py --root . --output configs/naos_ai_surface_catalogue.yaml; \
	else \
		echo "    skip (surface catalogue emitter not installed for this tier)"; \
	fi
	@echo "🔄 [gov-refresh] Refreshing declared AI component inventory..."
	@if [ -f scripts/naos_ai_component_inventory.py ]; then \
		"$(PYTHON)" scripts/naos_ai_component_inventory.py $(NAOS_COMMON_ARGS) $(NAOS_STRICT_ARG); \
	else \
		echo "    skip (AI component inventory not installed for this tier)"; \
	fi
	@echo "🔄 [gov-refresh] Reviewing plan coherence..."
	@if [ -f scripts/naos_plan_coherence.py ]; then \
		"$(PYTHON)" scripts/naos_plan_coherence.py $(NAOS_COMMON_ARGS); \
	else \
		echo "    skip (plan coherence reviewer not installed for this tier)"; \
	fi
	@echo "🔄 [gov-refresh] Regenerating dashboard..."
	"$(PYTHON)" scripts/workflows/generate_naos_dashboard.py $(NAOS_COMMON_ARGS)
	@echo "✅ gov-refresh complete"

gov-full: gov-refresh ## gov-refresh + truth validation
	@echo "🔍 [gov-full] Running truth validation..."
	"$(PYTHON)" scripts/naos_validate_truth.py
	@echo "✅ gov-full complete"

gov-status: ## Print quick status from PROJECT_STATUS.md
	@grep -A 5 "## Current Status" $(NAOS_ROOT)/PROJECT_STATUS.md 2>/dev/null || \
	 echo "naos/PROJECT_STATUS.md not found. Run: make -f Makefile.naos gov-refresh"

# ─── Validation ─────────────────────────────────────────────────────────────

validate-all: ## Run all non-AI validators (task registry, task coherence, metrics, specs, traceability, configs, architecture, mermaid)
	@echo "🔍 Running governance validators..."
	@if [ -f scripts/naos_validate_truth.py ]; then \
		"$(PYTHON)" scripts/naos_validate_truth.py; \
	else \
		echo "    skip (truth validator not installed for this tier)"; \
	fi
	@echo "  — task registry semantics"
	@if [ -f scripts/naos_validate_task_registry.py ]; then \
		"$(PYTHON)" scripts/naos_validate_task_registry.py; \
	else \
		echo "    skip (task registry validator not installed for this tier)"; \
	fi
	@echo "  — task coherence"
	@if [ -f scripts/validators/validate_task_coherence.py ]; then \
		"$(PYTHON)" scripts/validators/validate_task_coherence.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — metrics coherence"
	@if [ -f scripts/validators/validate_metrics_coherence.py ]; then \
		"$(PYTHON)" scripts/validators/validate_metrics_coherence.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — spec files"
	@if [ -f scripts/validators/validate_specs.py ]; then \
		"$(PYTHON)" scripts/validators/validate_specs.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — spec-pack contract"
	@if [ -f scripts/naos_spec_pack_contract.py ]; then \
		"$(PYTHON)" scripts/naos_spec_pack_contract.py $(NAOS_COMMON_ARGS) $(NAOS_STRICT_ARG); \
	else \
		echo "    skip (spec-pack contract validator not installed for this tier)"; \
	fi
	@echo "  — spec cascade coherence"
	@if [ -f scripts/naos_detect_spec_drift.py ] && [ -f specs/03-requirements.md ]; then \
		"$(PYTHON)" scripts/naos_detect_spec_drift.py $(NAOS_COMMON_ARGS) $(NAOS_STRICT_ARG); \
	else \
		echo "    skip (spec cascade not applicable for this project)"; \
	fi
	@echo "  — traceability headers"
	@if [ -f scripts/validators/validate_traceability_headers.py ]; then \
		"$(PYTHON)" scripts/validators/validate_traceability_headers.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — canonical module-header traceability"
	@if [ -f scripts/naos_module_header_traceability.py ]; then \
		"$(PYTHON)" scripts/naos_module_header_traceability.py $(NAOS_COMMON_ARGS); \
	else \
		echo "    skip (module-header traceability validator not installed for this tier)"; \
	fi
	@echo "  — control-plane review routing"
	@if [ -f scripts/naos_control_plane_review.py ]; then \
		"$(PYTHON)" scripts/naos_control_plane_review.py $(NAOS_COMMON_ARGS); \
	else \
		echo "    skip (control-plane review evaluator not installed for this tier)"; \
	fi
	@echo "  — configs"
	@if [ -f scripts/validators/validate_configs.py ]; then \
		"$(PYTHON)" scripts/validators/validate_configs.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — architecture coherence"
	@if [ -f scripts/validators/validate_architecture_coherence.py ]; then \
		"$(PYTHON)" scripts/validators/validate_architecture_coherence.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — mermaid diagrams"
	@if [ -f scripts/validators/lint_mermaid_diagrams.py ]; then \
		"$(PYTHON)" scripts/validators/lint_mermaid_diagrams.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — test AC/SCEN references"
	@if [ -f scripts/validators/validate_test_ac_references.py ]; then \
		"$(PYTHON)" scripts/validators/validate_test_ac_references.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — AC completion evidence"
	@if [ -f scripts/naos_ac_completion_evidence.py ]; then \
		"$(PYTHON)" scripts/naos_ac_completion_evidence.py $(NAOS_COMMON_ARGS) $(NAOS_STRICT_ARG); \
	else \
		echo "    skip (AC completion evidence validator not installed for this tier)"; \
	fi
	@echo "  — agent frontmatter"
	@if [ -f scripts/validators/validate_agents.py ]; then \
		"$(PYTHON)" scripts/validators/validate_agents.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — skill frontmatter"
	@if [ -f scripts/validators/validate_skills.py ]; then \
		"$(PYTHON)" scripts/validators/validate_skills.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — instruction frontmatter"
	@if [ -f scripts/validators/validate_instructions.py ]; then \
		"$(PYTHON)" scripts/validators/validate_instructions.py; \
	else \
		echo "    skip (validator not installed for this tier)"; \
	fi
	@echo "  — AI tool-surface catalogue"
	@if [ -f scripts/naos_emit_capabilities.py ]; then \
		"$(PYTHON)" scripts/naos_emit_capabilities.py --root . --output configs/naos_ai_surface_catalogue.yaml --check; \
	else \
		echo "    skip (surface catalogue emitter not installed for this tier)"; \
	fi
	@echo "  — memory setup"
	@if [ -f scripts/validators/validate_memory_setup.py ]; then \
		"$(PYTHON)" scripts/validators/validate_memory_setup.py --root .; \
	else \
		echo "    skip (memory validator not installed for this tier)"; \
	fi
	@echo "  — control-plane self-check"
	@$(MAKE) --no-print-directory -f Makefile.naos naos-self-check
	# [ADAPT: add project-specific validators here]
	@echo "NAOS validate-all finished; review findings above before treating the run as clean."

naos-readiness: ## Check lifecycle readiness before Phase 2, baseline, or drift work
	@echo "🔎 Checking NAOS lifecycle readiness..."
	"$(PYTHON)" scripts/naos_readiness.py --target baseline

drift-check: ## Check for governance drift indicators
	@echo "🔍 Checking for governance drift..."
	@# Check for archive folders
	@find . -type d -name "archive" -not -path "./.git/*" \
	  -exec echo "  ⚠️  Archive folder found: {}" \;
	@# Check for backup files
	@find . \( -name "*.bak" -o -name "*_backup*" \) -not -path "./.git/*" \
	  -exec echo "  ⚠️  Backup file found: {}" \;
	@# Check for session files
	@find . -name "session_*.md" -not -path "./.git/*" \
	  -exec echo "  ⚠️  Session file found: {}" \;
	@echo "✅ drift-check complete (see ⚠️ warnings above)"

# ─── Code Quality ────────────────────────────────────────────────────────────

function-index: ## Regenerate FUNCTION_INDEX.yaml from src/
	@echo "🔄 Regenerating function index..."
	"$(PYTHON)" scripts/naos_code_quality_audit.py --generate-index
	@echo "✅ Function index regenerated: naos/inventory/FUNCTION_INDEX.yaml"

semantic-audit: ## Optional project-configured AI code quality review (uses LLM when enabled)
	@echo "🔍 Running semantic audit..."
	"$(PYTHON)" scripts/naos_code_quality_audit.py --semantic-audit
	@echo "✅ Semantic audit complete"

# ─── Governance Audit ──────────────────────────────────────────────────────────

naos-audit: ## Governance completeness audit — 7 categories, 0-10 scoring (inspired by ECC harness-audit)
	@echo "🔍 Running governance completeness audit..."
	"$(PYTHON)" scripts/naos_governance_audit.py
	@echo "✅ Audit complete"

naos-conformance: ## Static conformance check — writes naos/reports/conformance_latest.json
	@echo "🔍 Running conformance check..."
	"$(PYTHON)" .github/autoresearch/runner.py --conformance \
		--output naos/reports/conformance_latest.json
	@echo "✅ Conformance check complete — run 'make -f Makefile.naos gov-refresh' to update DASHBOARD.md"

admissibility-pack: ## Bundle governance evidence for reviewer/vendor-cascade handoff
	@echo "📦 Bundling admissibility evidence pack..."
	@[ -f scripts/workflows/make_admissibility_pack.py ] || { echo "❌ scripts/workflows/make_admissibility_pack.py not installed for this project tier"; exit 1; }
	"$(PYTHON)" scripts/workflows/make_admissibility_pack.py --root $(NAOS_ROOT)
	@echo "✅ Admissibility pack ready under $(NAOS_ROOT)/"

# ─── Control-Plane Validators ───────────────────────────────────────────────

naos-claims: ## Validate public/project claims against local evidence
	@echo "🔎 [naos-claims] Validating claims for profile $(NAOS_PROFILE)..."
	@if [ -f scripts/naos_validate_claims.py ]; then \
		"$(PYTHON)" scripts/naos_validate_claims.py $(NAOS_COMMON_ARGS) $(NAOS_STRICT_ARG); \
	else \
		echo "    skip (claims validator not installed for this tier)"; \
