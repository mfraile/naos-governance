# NAOS secure-coding P3 reporting targets.
# Run directly with: make -f Makefile.naos.secure-coding-reporting <target>

PYTHON ?= python
NAOS_PROFILE ?= lite
NAOS_P3_DISPATCH = import importlib.util, runpy, sys; entry = sys.argv.pop(1); runpy.run_module('naos_governance.secure_coding_reporting_cli', run_name='__main__', alter_sys=True) if importlib.util.find_spec('naos_governance') is not None else runpy.run_path(entry, run_name='__main__')
NAOS_P3_SCRIPT ?= scripts/naos_secure_coding_reporting.py
NAOS_ROOT ?= naos
NAOS_POLICY ?=
NAOS_STRICT ?=

NAOS_POLICY_ARG := $(if $(NAOS_POLICY),--policy $(NAOS_POLICY),)
NAOS_STRICT_ARG := $(if $(NAOS_STRICT),--strict,)
NAOS_P3_ARGS := --profile $(NAOS_PROFILE) --naos-root $(NAOS_ROOT) $(NAOS_POLICY_ARG) $(NAOS_STRICT_ARG)

.PHONY: naos-secure-coding-reporting naos-secure-coding-reporting-project

naos-secure-coding-reporting: ## Refresh P1/P2 sources and generate the five P3 dimensions
	@"$(PYTHON)" -c "$(NAOS_P3_DISPATCH)" "$(NAOS_P3_SCRIPT)" $(NAOS_P3_ARGS) --refresh-sources

naos-secure-coding-reporting-project: ## Project P3 into existing dashboard/evidence artifacts
	@"$(PYTHON)" -c "$(NAOS_P3_DISPATCH)" "$(NAOS_P3_SCRIPT)" $(NAOS_P3_ARGS) --refresh-sources --project
